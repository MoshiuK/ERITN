@using AccessManagement.Framework.Tenants
@model AccessManagement.Web.Areas.Storefront.ViewModels.Enrollment.OrganizationEnrollmentViewModel
@{
  Layout = "../Shared/_StorefrontLayout.cshtml";
}

@{
  var theme = (TenantTheme)ViewBag.Theme;
}

<div class="row storefront-enroll page-header">
  <div class="col-md-6">
    <h3 class="title">YOUR INVITATION TO JOIN</h3>
  </div>
  <div class="col-md-6">
  </div>
</div>

<div class="row storefront-enroll contact-details-section border-bottom">
  <div class="col-md-10">
    <h4 class="subtitle">Thank you for your participation in the @theme.BrandCaption.</h4>
    <p>
      You received this invitation because your organization, <strong>@Html.ValueFor(m => m.OrganizationName) </strong> uses
      the <strong>@theme.BrandCaption</strong> online system to coordinate expedited access for their emergency response and
      recovery teams.  You have been invited to join.  Complete the form below so you can be approved for access and (when the
      program is activated for an emergency event) you can get your expedited access documents.
    </p>
  </div>
  <div class="col-md-2">
    <div class="pull-right">
      @Html.DisplayFor(m => m.OrganizationAvatar)
    </div>
  </div>
</div>

@using (Html.BeginForm("NewEnrollment", "Enrollment", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
{
  @Html.AntiForgeryToken()

  @Html.HiddenFor(m => m.NewEnrollment.TicketId)
  @Html.HiddenFor(m => m.NewEnrollment.TicketNonce)

  <div class="row storefront-enroll contact-details-section border-bottom">
    <div class="col-md-12">
      <h4 class="subtitle">Contact Details</h4>
      <p class="m-b-lg">
        We need to contact you when the program is activated for an emergency event relevant to your organization so we can
        send your access documents to your email and/or mobile phone.  We may (very occasionally) send you news about
        important changes or improvements to the program.
      </p>
      <div class="form-group">
        @Html.LabelFor(m => m.NewEnrollment.Name, new { @class = "col-sm-2 control-label" })
        <div class="col-sm-8">
          @Html.EditorFor(m => m.NewEnrollment.Name)
          <div class="help-block">
            <small>
              Your name will appear on your access documents as shown here.
            </small>
          </div>
        </div>
      </div>
      <div class="form-group">
        @Html.LabelFor(m => m.NewEnrollment.Email, new { @class = "col-sm-2 control-label" })
        <div class="col-sm-8">
          @Html.EditorFor(m => m.NewEnrollment.Email)
          <div class="help-block">
            <small>
              We send email to this address so you can get your access documents for an emergency events.
            </small>
          </div>
        </div>
      </div>
      <div class="form-group">
        @Html.LabelFor(m => m.NewEnrollment.Phone, new { @class = "col-sm-2 control-label" })
        <div class="col-sm-4">
          @Html.EditorFor(m => m.NewEnrollment.Phone)
        </div>
        <div class="col-sm-offset-2 col-sm-8">
          <div class="help-block">
            <small>
              We send messages to this mobile number so you can get your access documents on your phone. (Optional)
            </small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row storefront-enroll photo-id-section border-bottom">
    <div class="col-md-12">
      <h4 class="subtitle">PHOTO ID</h4>
      <p class="m-b-lg">
        You should carry 2 forms of photo ID with you whenever you transit into or thru emergency zones. These documents
        should be available for inspection at law enforcement checkpoints to ensure your access is expedited.
      </p>
      <div class="form-group">
        @Html.LabelFor(m => m.NewEnrollment.PrimaryPhotoId, new { @class = "col-sm-2 control-label" })
        <div class="col-sm-8">
          @Html.DropDownListFor(m => m.NewEnrollment.PrimaryPhotoId, Model.AvailablePrimaryPhotoIds, new { id = "primaryIdSelect", @class = "form-control select2-component" })
          <div class="help-block">
            <small>
              A government issued photo ID (driver's license, passport, military ID, etc.) is recommended as the primary photo ID to make
              available to law enforcement for inspection.
            </small>
          </div>
        </div>
      </div>
      <div class="form-group">
        @Html.LabelFor(m => m.NewEnrollment.SecondaryPhotoId, new { @class = "col-sm-2 control-label" })
        <div class="col-sm-8">
          @Html.DropDownListFor(m => m.NewEnrollment.SecondaryPhotoId, Model.AvailableSecondaryPhotoIds, new { id = "secondaryIdSelect", @class = "form-control select2-component" })
          <div class="help-block">
            <small>
              A photo is not required on your secondary ID, but it is highly recommended.  Law enforcement may deny access unless a
              secondary photo ID is available for inspection.
            </small>
          </div>
        </div>
      </div>
      <div id="photoAlertDiv" class="alert alert-danger">
        <p id="message">&nbsp;</p>
      </div>
    </div>
  </div>

  <div class="row storefront-enroll photograph-section border-bottom">
    <div class="col-md-12">
      <h4 class="subtitle">PHOTOGRAPH</h4>
      <p class="m-b-lg">
        Some emergency access documents require your photograph for identification purposes.  It is recommended that
        you upload a photograph so these documents will be accepted at law enforcement checkpoints. <br />
      </p>
      <div class="form-group">
        @Html.LabelFor(m => m.NewEnrollment.Photograph, new { @class = "col-sm-2 control-label" })
        <div class="col-sm-3">
          @Html.EditorFor(m => m.NewEnrollment.Photograph)
        </div>
        <div class="col-sm-5">
          <div class="help-block">
            <small>
              Use a passport style photograph with your face clearly visible.<br />
              <br />
              Minimum 400x400 pixels. <br />
              Maximum size 3MB. <br />
              <br />
              You can skip this step and provide a photo later.
            </small>
          </div>
        </div>
      </div>
      <div id="photoSizeAlertDiv" class="alert alert-danger">
        <p id="sizeMessage">&nbsp;</p>
      </div>
    </div>
  </div>

  if (Model.IsAccessSpecificsSectionShown)
  {
    <div class="row storefront-enroll contact-details-section border-bottom">
      <div class="col-md-12">
        <h4 class="subtitle">EMERGENCY ACCESS SPECIFICS</h4>
        <p class="m-b-lg">
          Designate your specific emergency access needs using the options below.  Some options may be restricted.
        </p>
        @if (Model.CanEditOrganizationRelationship)
        {
          <div class="form-group">
            @Html.LabelFor(m => m.NewEnrollment.OrganizationRelationship, new { @class = "col-sm-2 control-label" })
            <div class="col-sm-8">
              @Html.EditorFor(m => m.NewEnrollment.OrganizationRelationship)
              @Html.ValidationMessageFor(m => m.NewEnrollment.OrganizationRelationship)
              <div class="help-block">
                <small>
                  The nature of your relationship with <strong>@Model.OrganizationName</strong>.
                </small>
              </div>
            </div>
          </div>
        }
        @if (Model.CanEditAccessLevel)
        {
          <div class="form-group">
            @Html.LabelFor(m => m.NewEnrollment.SpecificAccessLevel, new { @class = "col-sm-2 control-label" })
            <div class="col-sm-8">
              @Html.DropDownListFor(m => m.NewEnrollment.SpecificAccessLevel, Model.AvailableAccessLevels, new { @class = "form-control select2-component" })
              <div class="help-block">
                <small>
                  The phased re-entry of access to and incident site or restricted area is based on response and recovery
                  needs, site conditions and safety concerns.
                </small>
              </div>
            </div>
          </div>
        }
        @if (Model.CanEditLocation)
        {
          <div class="form-group">
            @Html.LabelFor(m => m.NewEnrollment.SpecificLocation, new { @class = "col-sm-2 control-label" })
            <div class="col-sm-8">
              @Html.DropDownListFor(m => m.NewEnrollment.SpecificLocation, Model.AvailableLocations, new { @class = "form-control select2-component" })
              <div class="help-block">
                <small>
                  Please select your default location. If you are unsure of what to pick, you can allow your organization to designate.
                </small>
              </div>
            </div>
          </div>
        }
        @if (Model.CanEditPurpose)
        {
          <div class="form-group">
            @Html.LabelFor(m => m.NewEnrollment.SpecificPurpose, new { @class = "col-sm-2 control-label" })
            <div class="col-sm-8">
              @Html.DropDownListFor(m => m.NewEnrollment.SpecificPurpose, Model.AvailablePurposes, new { @class = "form-control select2-component" })
            </div>
            <div class="col-sm-offset-2 col-sm-8">
              <div class="help-block">
                <small>
                  Please select your purpose of reentry. If you are unsure of what to select, you can allow your organization to designate.
                </small>
              </div>
            </div>
          </div>
        }
      </div>
    </div>
  }

  <div class="row storefront-enroll terms-conditions-section border-bottom">
    <div class="col-md-12 m-b-md">
      <h4 class="subtitle">TERMS & CONDITIONS</h4>
      <p>
        We provide organization registration and personnel enrollment services for expedited access into or thru emergency
        zones in accordance with the requirements of emergency management authority in each jurisdiction participating
        in the <strong>@theme.BrandCaption</strong>.  To provide these services, we must collect and use your personal data.
        We detail our practices in the <a target="_blank" href="@theme.LinksTerms">Terms &amp; Conditions</a> and
        <a target="_blank" href="@theme.LinksPrivacy">Data Privacy Policy</a> which you must agree to in order to use
        our products.
      </p>
      @Html.EditorFor(m => m.NewEnrollment.TermsAndConditionsAccepted, null, "termsAcceptedCheckbox")
    </div>
  </div>

  <div class="row m-t-lg">
    <div class="col-md-12 text-center">
      <button disabled id="submitButton" type="submit" class="btn btn-lg btn-success">Save My Information</button>
    </div>
  </div>
}

@section scripts
{
  <script>
    $(document).ready(function () {
      var primaryIdSelect = $('#primaryIdSelect');
      var secondaryIdSelect = $('#secondaryIdSelect');
      var primaryIdSelectedVal = primaryIdSelect.val();
      var secondaryIdSelectedVal = secondaryIdSelect.val();
      var message = $('#message');
      var alertDiv = $('#photoAlertDiv');

      alertDiv.hide();
      $('#photoSizeAlertDiv').hide();
      // If either of the ids are changed to match the other currently selected id,
      // update the select to the previous value and display an error message.
      $('#secondaryIdSelect').on('change', function () {
        if (secondaryIdSelect.val() === primaryIdSelect.val()) {
          message.html('Please select two different forms of id.');
          secondaryIdSelect.val(secondaryIdSelectedVal).trigger('change.select2');
          alertDiv.show();
          alertDiv.delay(2000).fadeOut();
        } else {
          secondaryIdSelectedVal = secondaryIdSelect.val();
          message.html('&nbsp');
          alertDiv.hide();
        }
      });

      $('#primaryIdSelect').on('change', function () {
        if (primaryIdSelect.val() === secondaryIdSelect.val()) {
          message.html('Please select two different forms of id.');
          primaryIdSelect.val(primaryIdSelectedVal).trigger('change.select2');
          alertDiv.show();
          alertDiv.delay(2000).fadeOut();
        } else {
          primaryIdSelectedVal = primaryIdSelect.val();
          message.html('&nbsp');
          alertDiv.hide();
        }
      });

      $('#termsAcceptedCheckbox').click(function () {
        $('#submitButton').prop('disabled', function (i, v) { return !v; });
      });

      $('#NewEnrollment_Photograph').bind('change', function () {
        if (this.files.length > 0 && this.files[0].size > 3780000) {
          $('#sizeMessage').html('The photo you selected is too large. Please select a photo less than 3 MB.');
          $('#photoSizeAlertDiv').show().delay(2000).fadeOut();
          // Reset the input.
          $('#NewEnrollment_Photograph').wrap('<form>').closest('form').get(0).reset();
          $('#NewEnrollment_Photograph').unwrap();
        }
      });
    });
  </script>
}