@model AccessManagement.Framework.Tenants.TransitLocationResource
@{
  var id = Html.ValueFor(m => m.Id);
}
<div class="transit-location-checkbox checkbox checkbox-success" style="background-image: url(@Html.ValueFor(m => m.ImageUri)">
  <input id="chbx-@id" type="checkbox" name="TransitLocations" value="@id"/>
  <label for="chbx-@id"></label>
  <div class="transit-location-checkbox-caption">
    <span>@Html.ValueFor(m => m.Name)</span>
  </div>
</div>
