@model AccessManagement.Web.Areas.Storefront.ViewModels.Registration.UpdatePaymentViewModel

<div class="col-md-offset-2 col-md-8">
  <div class="form-group">
    @Html.Label("Name on Card")
    @Html.Editor("name", new { htmlAttributes = new { @class = "form-control", placeholder = "Name on Card" } })
  </div>
  <div class="form-group">
    @Html.Label("Card Number")
    <div id="cardNumber">
      <!-- A Stripe Element will be inserted here. -->
    </div>
  </div>
  <div class="form-group">
    @Html.Label("CVC")
    <div id="cardCvc">
      <!-- A Stripe Element will be inserted here. -->
    </div>
  </div>
  <div class="form-group">
    @Html.Label("Expiration Date")
    <div id="cardExpiry">
      <!-- A Stripe Element will be inserted here. -->
    </div>
  </div>
  <div class="form-group">
    @Html.Label("Card Billing Zip Code")
    @Html.Editor("address_zip", new { htmlAttributes = new { @class = "form-control", placeholder = "Zip Code" } })
  </div>
</div>
