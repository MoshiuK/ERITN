@model AccessManagement.Web.Areas.Storefront.ViewModels.Registration.UpdatePaymentViewModel

<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<div class="col-md-offset-2 col-md-8">
  <div class="form-group">
    @Html.LabelFor(m => m.InvoiceName)
    @Html.EditorFor(m => m.InvoiceName)
    @Html.ValidationMessageFor(m => m.InvoiceName)
  </div>
  <div class="form-group">
    @Html.LabelFor(m => m.Phone)
    @Html.EditorFor(m => m.Phone)
    @Html.ValidationMessageFor(m => m.Phone)
  </div>
  <div class="col-md-12">
    <h4>Billing Address</h4>
  </div>
  <div class="form-group">
    @Html.LabelFor(m => m.InvoiceStreetAddress1)
    @Html.EditorFor(m => m.InvoiceStreetAddress1)
    @Html.ValidationMessageFor(m => m.InvoiceStreetAddress1)
  </div>
  <div class="form-group">
    @Html.LabelFor(m => m.InvoiceStreetAddress2)
    @Html.EditorFor(m => m.InvoiceStreetAddress2)
    @Html.ValidationMessageFor(m => m.InvoiceStreetAddress2)
  </div>
  <div class="form-group">
    @Html.LabelFor(m => m.InvoiceCity)
    @Html.EditorFor(m => m.InvoiceCity)
    @Html.ValidationMessageFor(m => m.InvoiceCity)
  </div>
  <div class="form-group">
    @Html.LabelFor(m => m.InvoiceState)
    @Html.DropDownListFor(m => m.InvoiceState, Model.SelectLocations, new { @class = "select2-component form-control" })
    @Html.ValidationMessageFor(m => m.InvoiceState)
  </div>
  <div class="form-group">
    @Html.LabelFor(m => m.ZipCode)
    @Html.EditorFor(m => m.ZipCode)
    @Html.ValidationMessageFor(m => m.ZipCode)
  </div>

  <div class="form-group pull-right">
    Not ready to complete registration? <a id="quoteButton">Get a printable quote now.</a>
  </div>
</div>

<script>
  $(document).ready(function () {
    $("#quoteButton").on('click', function () {
      const referenceid = '@(Model.ReferenceId)';
      const tenantProductId = '@(Model.TenantProductId)';
      const organizationName = "@Html.Raw(Model.OrganizationName)";
      const quantity = $("#Quantity").val();
      const name = $("#InvoiceName").val();
      const emailAddress = $("#EmailAddress").val();
      const phone = $("#Phone").val();
      const addressOne = $("#InvoiceStreetAddress1").val();
      const addressTwo = $("#InvoiceStreetAddress2").val();
      const city = $("#InvoiceCity").val();
      const state = $("#InvoiceState").val();
      const zipCode = $("#ZipCode").val();

      var url='@Html.Raw(@Url.Action("GenerateQuote","Registration",new {
              referenceId="__referenceId__",tenantProductId="__tenantProductId__",
              quantity="__quantity__",organizationName="__organizationName__",name="__name__",emailAddress="__emailAddress__",
              phone="__phone__",addressOne="__addressOne__",addressTwo="__addressTwo__",
              city="__city__",state="__state__",zipCode="__zipCode__"}))';

      url = url.replace('__referenceId__', referenceid);
      url = url.replace('__tenantProductId__', tenantProductId);
      url = url.replace('__quantity__', quantity);
      url = url.replace('__name__', name);
      url = url.replace('__emailAddress__', emailAddress);
      url = url.replace('__phone__', phone);
      url = url.replace('__addressOne__', addressOne);
      url = url.replace('__addressTwo__', addressTwo);
      url = url.replace('__city__', city);
      url = url.replace('__state__', state);
      url = url.replace('__zipCode__', zipCode);
      url = url.replace('__organizationName__', organizationName);

      window.location.href = encodeURI(url);
    });
  });

</script>
