@model IReadOnlyCollection<AccessManagement.Models.Emergency.CredentialActivity>
  <div class="card">
    <div class="card-heading">
      <div class="card-title"><h4>Activity</h4></div>
    </div>
    <div class="card-content">
      @foreach(var c in Model)
      {
      <ul>
        <li>@c.OccurredAt.ToString() - @c.Remarks</li>
      </ul>
      }
    </div>
  </div>
