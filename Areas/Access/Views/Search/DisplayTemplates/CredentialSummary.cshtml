@model AccessManagement.Framework.Credentials.CredentialSummary

<div class="card">
  @Html.Partial("Partials/_CredentialSummaryHeader", Model)
  <div class="card-content">
    <div class="row">
      <div class="col-md-12">
        <h4 class="event-name"><strong>@Html.DisplayFor(m => m.EmergencyEvent.Name)</strong> - @Html.DisplayFor(m => m.CredentialType.Name)</h4>
      </div>
    </div>
    <div class="row m-b-sm">
      <div class="col-md-12">
        <div class="pull-left">
          <h3 class="member-name">@Html.DisplayFor(m => m.Member.Name)</h3>
        </div>
        <div class="pull-right">
          <div class="pull-right">
            @Html.DisplayFor(m => m.Jurisdiction.Avatar)
          </div>
          <div class="pull-right m-r-md">
            <small class="text-muted">Issuing jurisdiction</small><br />
            <span class="">@Html.DisplayFor(m => m.Jurisdiction.Name)</span>
          </div>
        </div>
        <div class="pull-right m-r-md">
          <div class="pull-right">
            @Html.DisplayFor(m => m.OrganizationAvatar)
          </div>
          <div class="pull-right m-r-md">
            <small class="text-muted">Issuing organization</small><br />
            <span class="">@Html.DisplayFor(m => m.Organization.Name)</span>
          </div>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-md-3">
        <img class="member-photo" src="@Html.ValueFor(m => m.MemberAvatar.Medium)" alt="@Html.ValueFor(m => m.Member.Name)" />
        <div class="well">
          <small class="text-muted">Access level</small><br />
          @Html.DisplayFor(m => m.AccessLevel)
          <small class="text-muted">Credential number</small><br />
          <h4 class="reference-id">@Html.DisplayFor(m => m.ReferenceId)</h4>
        </div>
      </div>
      <div class="col-md-9">
        <div class="row">
          <div class="col-md-6">
            @Html.Partial("Partials/_AttributesTable", Model.Attributes)
          </div>
          <div class="col-md-6">
            @Html.Partial("Partials/_PropertiesTable", Model.Properties)
          </div>
        </div>
      </div>
    </div>
  </div>
  @Html.Partial("Partials/_CredentialSummaryFooter", Model)
</div>
