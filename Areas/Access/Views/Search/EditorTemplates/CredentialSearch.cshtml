@model AccessManagement.Web.Areas.Access.ViewModels.CredentialSearch
@using AccessManagement.Framework.Tenants
@using Juillet.Web.Mvc.Html
@{
  var theme = (TenantTheme)ViewBag.Theme;
}

<div class="row m-t-lg">
  <div class="col-md-2">
    <div class="m-t-md">
      <img src="@theme.ImageUrlLogo100X100" alt="@theme.BrandCaption" />
    </div>    
  </div>
  <div class="col-md-8">
    <div class="row">
      <div class="col-md-12">
        <div class="pull-left">
          <h1>Credential search</h1>
        </div>
        <div class="pull-right">
          <h5 class="text-danger m-t-lg" title="Credential search is only available to authorized law enforcement and access point officers. All searches are recorded and monitored.">@Html.GlyphFa("lock") FOR OFFICIAL USE ONLY</h5>
        </div>
      </div>
    </div>
    @using (Html.BeginForm("Query", "Search", FormMethod.Get, new { @class = "form-horizontal", id = "search-form" }))
    {
      <div class="row">
        <div class="col-md-10">
          <div class="form-group form-group-lg">
            @Html.EditorFor(m => m.Expression, new { @class = "form-control" })
          </div>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary btn-lg">
            @Html.GlyphFa("search") Search
          </button>    
        </div>
      </div>
    }
  </div>
</div>
