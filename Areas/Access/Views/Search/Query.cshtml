@model AccessManagement.Web.Areas.Access.ViewModels.QueryPageViewModel
@{
  Layout = "~/Areas/Access/Views/Shared/_AccessLayout.cshtml";

  var startPosition = (Model.PageOfContent.Metadata.TotalCount == 0) ? 0 : Model.PageOfContent.Metadata.StartPosition;
  var endPosition = Model.PageOfContent.Metadata.EndPosition;
  var total = Model.PageOfContent.Metadata.TotalCount;
}

@Html.ActionLink("Sign Out", "SigningOut", "Authentication", new { area = "" }, new { @class = "btn btn-sm btn-primary" })
@Html.EditorFor(m => m.Criteria)

@if (total > 0)
{
  <div class="row m-b-md">
    <div class="col-md-12">
      <h3 class="text-muted">Found @total matching credential(s).</h3>
      <div class="pull-right">
        <span class="text-muted small">Last refreshed <i class="fa fa-clock-o"></i> <time data-juillet-currenttime></time>.</span>
        @if (total > 1)
        {
          <span class="text-muted small">Showing @startPosition - @endPosition of @total items.</span>
        }
      </div>
    </div>
  </div>


  foreach (var card in Model.PageOfContent.Data)
  {
    @Html.DisplayFor(_ => card)
  }

  @Html.DisplayFor(m => m.Pager)

}

@section scripts
{
  <script type="text/javascript">
    $(function () {
      $('[data-toggle="popover"]').popover();
    })
  </script>
}
