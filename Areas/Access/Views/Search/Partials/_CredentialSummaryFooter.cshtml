@using AccessManagement.Framework.Credentials
@using Juillet.Web.Mvc.Html
@model CredentialSummary

@functions
{
  string GetTextCss(CredentialValidationItem item)
  {
    switch (item.Status)
    {
      case CredentialValidationStatus.InvalidForAccess:
      case CredentialValidationStatus.Unknown:
      case CredentialValidationStatus.IndeterminateForAccess:
        return "alert-danger";
      case CredentialValidationStatus.ValidWithWarningsForAccess:
        return "alert-warning";
      default:
        return string.Empty;
    }
  }

  string GetPreamble(CredentialValidationItem item)
  {
    switch (item.Status)
    {
      case CredentialValidationStatus.InvalidForAccess:
        return "INVALID";
      case CredentialValidationStatus.Unknown:
      case CredentialValidationStatus.IndeterminateForAccess:
        return "ERROR";
      case CredentialValidationStatus.ValidWithWarningsForAccess:
        return "WARNING";
      default:
        return string.Empty;
    }
  }
}

@if (Model.Outcome != CredentialValidationStatus.ValidForAccess)
{
  <div class="card-footer">
    <ul class="list-unstyled">
      @foreach (var err in Model.ValidationItems.Where(v => v.Status != CredentialValidationStatus.ValidForAccess))
      {
        <li>
          <div class="alert @GetTextCss(err)">@Html.GlyphFa("exclamation-circle") <strong>@GetPreamble(err)</strong> - @err.DisplayName - @err.Message</div>
        </li>
      }
    </ul>
  </div>
}
