@using AccessManagement.Framework.Credentials
@model CredentialSummary

@if (Model.Outcome == CredentialValidationStatus.InvalidForAccess)
{
  <div class="card-heading card-danger">
    <div class="card-title">NOT VALID FOR TRANSIT - @Model.ValidationItems.Count(c => c.Status == CredentialValidationStatus.InvalidForAccess) item(s) failed validation check.</div>
  </div>
}
else if (Model.Outcome == CredentialValidationStatus.IndeterminateForAccess ||
         Model.Outcome == CredentialValidationStatus.Unknown)
{
  <div class="card-heading card-danger">
    <div class="card-title">MORE INFORMATION REQUIRED - @Model.ValidationItems.Count(c => c.Status == CredentialValidationStatus.IndeterminateForAccess || c.Status == CredentialValidationStatus.Unknown) item(s) could not be checked.</div>
  </div>
}
else if (Model.Outcome == CredentialValidationStatus.ValidWithWarningsForAccess)
{
  <div class="card-heading card-warning">
    <div class="card-title">INSPECTION REQUIRED - @Model.ValidationItems.Count(c => c.Status == CredentialValidationStatus.ValidWithWarningsForAccess) item(s) had warnings, @Model.ValidationItems.Count(c => c.Status == CredentialValidationStatus.ValidForAccess) item(s) passed validation check.</div>
  </div>
}
else
{
  <div class="card-heading card-success">
    <div class="card-title">VALID FOR TRANSIT - @Model.ValidationItems.Count(c => c.Status == CredentialValidationStatus.ValidForAccess) item(s) passed validation check.</div>
  </div>
}
