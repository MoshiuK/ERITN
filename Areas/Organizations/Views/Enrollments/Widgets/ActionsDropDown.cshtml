@using AccessManagement.Models.Enrollment
@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.Areas.Organizations.ViewModels.Enrollments.EnrollmentTableRow
<div class="dropdown">
  <div class="btn btn-sm btn-link" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
    @Html.GlyphFa("ellipsis-h")
  </div>
  <ul class="dropdown-menu">
    <li>@Html.ActionLink("Details", "Details", new { id = Html.ValueFor(m => m.Id) })</li>
    <li>
      @Html.Partial("Widgets/AbandonDropDownItem", Model.Id)
    </li>
    @if (Model.EnrollmentType.Id == (int) EnrollmentTypes.SelfService)
    {
      <li role="separator" class="divider"></li>
      <li>
        @Html.Partial("Widgets/ResendInviteDropDownItem", Model.Id)
      </li>
    }
  </ul>
</div>
