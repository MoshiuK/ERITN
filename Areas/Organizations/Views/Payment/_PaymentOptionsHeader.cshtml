@model AccessManagement.Web.Areas.Organizations.ViewModels.Payments.AddOrderViewModel
<div class="table well well-sm description">
  <div class="row">
    <div class="col-md-12">
      <div class="col-md-2 small">
        Monthly Cost
      </div>
      <div class="col-md-1 small">

      </div>
      <div class="col-md-2 small">
        Annual Subscription
      </div>
      <div class="col-md-1 small">

      </div>
      <div class="col-md-3 small">
        Number of Emergency Personnel
      </div>
      <div class="col-md-1 small">

      </div>
      <div class="col-md-2 small">
        Annual Cost
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-md-12">
      <div class="col-md-2">
        <h4>
          @String.Format("{0:c}", Model.UnitPrice * .01)
        </h4>
        @Html.HiddenFor(_ => Model.UnitPrice)
      </div>
      <div class="col-md-1 small">
        <h4>
          X
        </h4>
      </div>
      <div class="col-md-2">
        <h4>
          @Html.DisplayFor(_ => Model.SubscriptionTermMonths) Months
          @Html.HiddenFor(_ => Model.SubscriptionTermMonths)
        </h4>
      </div>
      <div class="col-md-1 small">
        <h4>
          X
        </h4>
      </div>
      <div class="col-md-3">
        <h5>
          @Html.EditorFor(m => m.Quantity, new { htmlAttributes = new { @class = "form-control input-w-sm", min = 1 } })
        </h5>
      </div>
      <div class="col-md-1 small">
        <h4>
          =
        </h4>
      </div>
      <div class="col-md-2">
        <h4>
          <strong><span id="totalPrice"></span></strong>
        </h4>
      </div>
    </div>
  </div>
</div>
