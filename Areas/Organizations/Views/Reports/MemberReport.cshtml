@using AccessManagement.Web.Areas.Organizations.ViewModels.Reports;
@using Juillet.Web.Mvc.Html
@model MemberTableReport

<div class="row">
  <div class="col-md-12 m-h-15">
    <a href="@Url.Action("Index")">@Html.GlyphFa("arrow-circle-left") Back to Reports</a>
  </div>
</div>
<div class="row">
  <div class="col-md-12">
    <h2 class="text-primary heading-inline-block">@ViewBag.Title</h2>
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    <table class="table table-condensed">
      <thead>
      </thead>
      <tbody>
        @foreach (var row in Model.Rows.Data)
        {
          @Html.DisplayFor(_ => row)
        }
      </tbody>
    </table>
  </div>
</div>