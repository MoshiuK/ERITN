@model AccessManagement.Models.Reports.MemberTableCriteria

@using (Html.BeginForm())
{
  <div class="form-horizontal">
    @Html.ValidationSummary(true, "", new {@class = "text-danger"})

    @Html.HiddenFor(m => m.NotBefore)
    @Html.HiddenFor(m => m.NotAfter)

    <div class="form-group">
      @Html.LabelFor(model => model.SearchExpression, htmlAttributes: new {@class = "control-label col-md-2"})
      <div class="col-md-10">
        @Html.EditorFor(model => model.SearchExpression, new {htmlAttributes = new {@class = "form-control"}})
        @Html.ValidationMessageFor(model => model.SearchExpression, "", new {@class = "text-danger"})
      </div>
    </div>

    <div class="form-group">
      @Html.LabelFor(model => model.OrganizationMembershipTypes, htmlAttributes: new {@class = "control-label col-md-2"})
      <div class="col-md-10">
        @Html.EditorFor(model => model.OrganizationMembershipTypes, new {htmlAttributes = new {@class = "form-control"}})
        @Html.ValidationMessageFor(model => model.OrganizationMembershipTypes, "", new {@class = "text-danger"})
      </div>
    </div>

    <div class="form-group">
      @Html.LabelFor(model => model.CredentialAccessLevels, htmlAttributes: new {@class = "control-label col-md-2"})
      <div class="col-md-10">
        @Html.EditorFor(model => model.CredentialAccessLevels, new {htmlAttributes = new {@class = "form-control"}})
        @Html.ValidationMessageFor(model => model.CredentialAccessLevels, "", new {@class = "text-danger"})
      </div>
    </div>

  </div>
}
