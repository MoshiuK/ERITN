@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.Areas.Organizations.ViewModels.Dashboard.MemberSummaryCard
<div id="activeMemberCard" class="card">
  <div class="card-content">
    <div class="metric">
      <div class="metric-glyph">@Html.GlyphFa("user-o", GlyphStyles.X5)</div>
      <div class="metric-text">
        <span># Active Members</span>
        <h2>@Html.DisplayFor(m => m.ActiveMemberCount)</h2>
      </div>
    </div>
    <div class="row">
      <div class="col-sm-12">
        <h5 class="text-muted">Recently added</h5>
        <ul class="list-unstyled organizations-mru-list">
          @foreach (var m in Model.RecentMembers)
          {
            <li class="brand-unstyled-link">
              <a href="@Url.Action("Index","Person", new { id =  m.Id })">@Html.DisplayFor(_ => m.Annotation)</a>
            </li>
          }
        </ul>
      </div>
    </div>
  </div>
  <div class="card-footer card-footer-separator">
    <small><a href="@Url.Action("People", "PeopleHub")">View Page @Html.GlyphFa("arrow-circle-right")</a></small>
  </div>
</div>
