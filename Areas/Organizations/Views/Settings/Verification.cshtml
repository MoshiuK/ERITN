@model AccessManagement.Web.Areas.Organizations.ViewModels.Settings.VerificationDefaults

@{
  Layout = "_SettingsLayout.cshtml";
}

@using (Html.BeginForm("Verification", "Settings"))
{
  @Html.AntiForgeryToken()


  <div class="row m-b-lg">
    <div class="col-md-12">
      <h2>Attribute Verfications</h2>
      <h4>
        These settings will be used for verifying the attributes of your personnel.
      </h4>
      <div class="row m-b-lg">
        <div class="col-md-offset-2 col-md-4">
          <span class="">
            Length of time that attributes are verified for
          </span>
        </div>
        <div class="col-md-3">
          @Html.DropDownListFor(m => m.VerifiedValidityPeriod, Model.ValidityPeriods, new {@class = "form-control select2-component"})
        </div>
      </div>
    </div>
    <div class="row m-b-lg">
      <div class="col-md-12 text-center">
        <button type="submit" class="btn btn-lg btn-primary">Save Changes</button>
      </div>
    </div>
  </div>
}