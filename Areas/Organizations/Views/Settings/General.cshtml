@using AccessManagement.Web.Mvc
@model AccessManagement.Web.Areas.Administration.ViewModels.Organizations.OrganizationGeneralSettings

@{
    Layout = "_SettingsLayout.cshtml";
}

@Html.HiddenFor(m => m.TutorialsUrl)

<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h3 class="panel-title pull-left">@ViewBag.Title</h3>
        <div class="pull-right">
            <button id="btnEdit" type="button" class="btn btn-default btn-sm">
                <i class="glyphicon glyphicon-pencil"></i> Edit
            </button>
            <button id="btnSave" type="button" class="btn btn-primary btn-sm" style="display:none;">
                <i class="glyphicon glyphicon-floppy-disk"></i> Save
            </button>
            <button id="btnCancel" type="button" class="btn btn-default btn-sm" style="display:none;">
                Cancel
            </button>
        </div>
    </div>
    <div class="panel-body">

        <div id="saveAlert" class="alert" style="display:none;" role="alert"></div>

        @using (@Html.BeginForm("General", "Settings", null, FormMethod.Post, new { id = "generalSettingsForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.CorrelationId)
            @Html.HiddenFor(model => model.RegistrationData.AddressLatLng)
            @Html.HiddenFor(model => model.RegistrationData.PlaceId)

            <label class="control-label">Organization Information</label>

            <div class="form-group">
                @Html.LabelFor(model => model.RegistrationData.Name)
                @Html.EditorFor(model => model.RegistrationData.Name, new { htmlAttributes = new { @class = "form-control org-field", @readonly = "readonly" } })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.RegistrationData.Description)
                @Html.EditorFor(model => model.RegistrationData.Description, new { htmlAttributes = new { @class = "form-control org-field", @readonly = "readonly" } })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.RegistrationData.Address)
                @Html.EditorFor(model => model.RegistrationData.Address, new { htmlAttributes = new { @class = "form-control org-field", @readonly = "readonly" } })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.RegistrationData.Website)
                @Html.EditorFor(model => model.RegistrationData.Website, new { htmlAttributes = new { @class = "form-control org-field", @readonly = "readonly" } })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.RegistrationData.Domain)
                @Html.EditorFor(model => model.RegistrationData.Domain, new { htmlAttributes = new { @class = "form-control org-field", @readonly = "readonly" } })
            </div>

            <br />

            <label class="control-label">Business Contact</label>
            <div class="form-group">
                @Html.LabelFor(model => model.BusinessContact.Name)
                @Html.EditorFor(model => model.BusinessContact.Name, new { htmlAttributes = new { @class = "form-control org-field", @readonly = "readonly" } })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.BusinessContact.Email)
                @Html.EditorFor(model => model.BusinessContact.Email, new { htmlAttributes = new { @class = "form-control org-field", @readonly = "readonly" } })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.BusinessContact.Phone)
                @Html.EditorFor(model => model.BusinessContact.Phone, new { htmlAttributes = new { @class = "form-control org-field", @readonly = "readonly" } })
            </div>

            <label class="control-label">Emergency Contact</label>
            <div class="form-group">
                @Html.LabelFor(model => model.EmergencyContact.Name)
                @Html.EditorFor(model => model.EmergencyContact.Name, new { htmlAttributes = new { @class = "form-control org-field", @readonly = "readonly" } })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.EmergencyContact.Email)
                @Html.EditorFor(model => model.EmergencyContact.Email, new { htmlAttributes = new { @class = "form-control org-field", @readonly = "readonly" } })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.EmergencyContact.Phone)
                @Html.EditorFor(model => model.EmergencyContact.Phone, new { htmlAttributes = new { @class = "form-control org-field", @readonly = "readonly" } })
            </div>
        }
    </div>
</div>

<style>
    /* View mode: inputs look like plain text */
    .org-field[readonly] {
        background-color: transparent;
        border-color: transparent;
        box-shadow: none;
        cursor: default;
        padding-left: 0;
        color: #333;
    }

    /* Edit mode: standard Bootstrap input appearance */
    .org-field:not([readonly]) {
        background-color: #fff;
        border-color: #ccc;
        cursor: text;
    }

    .panel-heading {
        padding: 10px 15px;
    }
</style>

@section pagescripts
{
    <script src="~/Scripts/pages/organizations.settings.general.js"></script>
    @Html.ScriptForGooglePlacesAutoComplete()

    @if (!Model.HasCompletedSettingsTour)
    {
        <script type="text/javascript" src="~/Scripts/spstour.js"></script>
    }
}
