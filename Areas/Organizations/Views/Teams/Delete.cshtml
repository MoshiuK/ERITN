@model AccessManagement.Framework.Objects.GuidWithAnnotation
@{
  var returnUrl = ViewBag.ReturnUrl ?? Request.UrlReferrer?.ToString() ?? Url.Action("Index", "PeopleHub");
}
<div class="team-page">

  <div class="row m-t-sm">
    <div class="col-md-12">
      <ol class="breadcrumb">
        <li>@Html.ActionLink("People", "Index", "PeopleHub")</li>
        <li>@Html.ActionLink("Teams", "Index", "Teams")</li>
        <li class="active">@ViewBag.Title</li>
      </ol>
    </div>
  </div>

  <div class="row m-t-lg">
    <div class="col-md-offset-3 col-md-6">
      <div class="panel panel-danger">
        <div class="panel-heading">
          <h3 class="panel-title">Confirm Delete Team</h3>
        </div>
        <div class="panel-body">
          <p class="text-danger">
            Are you sure you want to delete the <strong>@Html.ValueFor(m => m.Annotation)</strong> team?
          </p>
          <div class="m-t-lg">
            @using (Html.BeginForm(new { id = Model.Id }))
            {
              @Html.AntiForgeryToken()

              <a href="@returnUrl" class="btn btn-default">Cancel</a>
              <button type="submit" class="btn btn-danger">Delete</button>
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</div>