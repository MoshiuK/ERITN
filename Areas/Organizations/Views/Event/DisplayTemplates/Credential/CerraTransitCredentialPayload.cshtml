@using AccessManagement
@using AccessManagement.Framework.Tenants
@using AccessManagement.Models.Emergency
@using Juillet.Profile
@using Juillet.Web.Mvc.Html
@model AccessManagement.Framework.Credentials.Cerra.CerraTransitCredentialPayload
@{
  var lookupTables = (ITenantLookupTables) ViewBag.LookupTables;
  var avatarStorage = (IAvatarStorage) ViewBag.AvatarStorage;

  var location = lookupTables.TransitLocations[Model.IssuingJurisdictionId];
  var organizationAvatar = avatarStorage.GetAvatarInfo(AccessManagementDataConstants.AvatarCategories.Organization, Model.IssuingOrganizationId);
  var memberAvatar = avatarStorage.GetAvatarInfo(AccessManagementDataConstants.AvatarCategories.Member, Model.SubjectId);

  MemberCredential memberCredential = ViewBag.MemberCredential;
}

<div class="row">
  <div class="col-md-4">
    <img class="photograph img-shadow" src="@memberAvatar.Medium" alt="@Model.SubjectName"/>
  </div>
  <div class="col-md-8">
    <h2>
      @Html.DisplayFor(m => m.SubjectName)
      <div class="credential-notify">
        @if (memberCredential.Member.NotifyByEmailAllowed)
        {
          <span>@Html.GlyphFa("envelope") @Html.DisplayFor(_ => memberCredential.Member.PrimaryEmail)</span><br/>
        }
        @if (memberCredential.Member.NotifyByPhoneAllowed)
        {
          <span>@Html.GlyphFa("phone") @Html.DisplayFor(_ => memberCredential.Member.PrimaryPhone)</span>
        }
      </div>
    </h2>

    <div class="row m-t-lg">
      <div class="col-sm-8">
        <span class="credential-caption">Credential number</span>
        <h3 class="m-n">@Html.DisplayFor(m => m.ReferenceId)</h3>
        <span class="credential-caption">Purpose</span>
        <h3 class="m-n">@Html.DisplayFor(m => m.Purpose) <small class="text-muted">(ESF-@Model.Esf.ToString("D"))</small></h3>
      </div>
      <div class="col-sm-4">
        @Html.Partial("DisplayTemplates/AccessLevelResource-Large", lookupTables.AccessLevels[Model.AccessLevelId])
      </div>
    </div>
  </div>
</div>

<div class="row m-t-md">
  <div class="col-md-12">
    <div class="row">
      <div class="col-md-6">
        <div class="row m-t-sm">
          <div class="col-sm-3">
            <img class="organization-logo" src="@organizationAvatar.Medium" alt="@Html.ValueFor(m => m.OrganizationName)" />
          </div>
          <div class="col-sm-9">
            <span class="credential-caption">Issuing Organization</span>
            <h4>
              @Html.DisplayFor(m => m.OrganizationName)
            </h4>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="row m-t-sm">
          <div class="col-sm-3">
            <img class="jurisdiction-logo" src="@location.Avatar.Medium" alt="@location.Name" />
          </div>
          <div class="col-sm-9">
            <span class="credential-caption">Issuing Location</span>
            <h4>
              @Html.DisplayFor(m => m.JurisdictionName)
            </h4>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
