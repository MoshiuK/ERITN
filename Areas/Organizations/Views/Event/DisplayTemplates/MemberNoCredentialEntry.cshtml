@using Juillet.Web.Mvc.Html
@model AccessManagement.Framework.Events.MemberNoCredentialEntry
@{
  var indent = ((bool?)ViewBag.indent ?? false) ? "m-l-lg" : string.Empty;
}
<tr>
  <td class="text-center" style="vertical-align: middle">
    <input type="checkbox"
           data-roster-entry-type="member-no-credential"
           data-member-id="@Model.CorrelationId"
           data-cleared="@Model.IsClearedForAccess" />
  </td>
  <td>
    <div>
      <small>
        @Html.DisplayFor(m => m.Avatar, "CredentialOwnerAvatar")
        @Html.DisplayFor(m => m.Name)
      </small>
    </div>
  </td>
  <td></td>
  <td>
    <div>
      @if (Model.IsClearedForAccess)
      {
        <small class="text-success">CLEARED FOR ACCESS</small>
      }
      else
      {
        <small class="text-danger"><em>NOT CLEARED</em></small>
      }
    </div>
  </td>
  <td></td>
  <td class="text-center">
    @if (Model.IsClearedForAccess)
    {
      <span class="fa fa-info-circle" data-html="true" data-placement="bottom" data-toggle="popover" title="Cleared for access"
         data-content="This member has been cleared for access but their credentials have not been generated yet.
                     Please use the 'Reissue Event Credentials' button at the top of the this table. Also, verify their purpose and location match those of this event."></span>
    }
    else
    {
      <span data-html="true" data-toggle="popover" data-placement="bottom" title="Unverified Attributes" data-content='This member has not had all their attributes verified.
         @Html.ActionLink("Verify Attributes Now", "Attributes", "Person", new {id = Model.CorrelationId}, new {data_toggle = "tooltip", data_placement = "top", title = "Update"}).'>
        @Html.GlyphFa("info-circle")
      </span>
    }
  </td>
</tr>