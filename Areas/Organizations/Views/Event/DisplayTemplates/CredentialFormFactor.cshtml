@using AccessManagement.Data.Blobs
@using AccessManagement.Models.Emergency
@using Juillet.SystemExtensions
@using Juillet.Web
@using Juillet.Web.Mvc.Html
@model CredentialFormFactor
@{
  ICredentialStorage credentialStorage = ViewBag.CredentialStorage;
  Guid eventId = ViewBag.EventId;
  MemberCredential memberCredential = ViewBag.MemberCredential;

  var downloadInfo = credentialStorage.GetCredentialInfo(new CredentialStorageMarker(
    CredentialStorageContainers.PublicContainer,
    eventId,
    memberCredential.IssuanceVersion,
    memberCredential.CorrelationId,
    Model.Id));

  var fileName = $"{memberCredential.Member.Name.Slugify()}.{Model.Name.Slugify()}.{CommonMimeContentTypes.ToFileExtension(Model.ContentType)}";
}
<a class="undecorated-link" href="@downloadInfo.ContentUri" target="_blank" download="@fileName">
  <div class="form-factor-download">
    <div class="form-factor-icon">
      @Html.GlyphFa("file-o", GlyphStyles.X2FixedWidth)
    </div>
    <div class="form-factor-name">
      @Html.DisplayFor(m => m.Name)
    </div>
    <div class="form-factor-description">
      <small>@Html.DisplayFor(m => m.Description)</small>
    </div>
  </div>
</a>
