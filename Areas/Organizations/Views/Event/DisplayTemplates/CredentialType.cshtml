@using AccessManagement.Models.Emergency
@using Juillet.Web.Mvc.Html
@model CredentialType
@{
  Guid eventId = ViewBag.EventId;
  MemberCredential memberCredential = ViewBag.MemberCredential;
}
<div class="card">
  <div class="card-content">
    <h3>@Html.GlyphFa("download") @Html.DisplayFor(m => m.Name) Downloads</h3>
    <div class="row">
      @{
        var formFactors = Model.FormFactors.Where(ff => ff.IsAvailableForPickup).ToArray();
        for (int i = 0; i < formFactors.Length; i += 2)
        {
          <div class="col-sm-4">
            @Html.DisplayFor(_ => formFactors[i].CredentialFormFactor)
          </div>
          if (i + 1 < formFactors.Length)
          {
            <div class="col-sm-4">
              @Html.DisplayFor(_ => formFactors[i + 1].CredentialFormFactor)
            </div>
          }
        }
      }
      <div class="col-sm-4">
        @if (memberCredential.Member.NotifyByEmailAllowed || memberCredential.Member.NotifyByPhoneAllowed)
        {
          <div class="p-sm">
            @using (Html.BeginForm("DistributeCredentials", "Event", new {id = eventId}))
            {
              @Html.AntiForgeryToken()

              <input type="hidden" name="credentialIds" value="@memberCredential.CorrelationId"/>

              <button type="submit" class="btn btn-primary btn-block btn-send-credential">
                <div class="btn-icon">
                  @Html.GlyphFa("paper-plane")
                </div>
                <div class="btn-caption">
                  Send credentials
                </div>
              </button>
            }
          </div>
        }
        else
        {
          <div class="p-sm">
            <small class="text-muted"><em>Download only. No email or phone contact allowed.</em></small>
          </div>
        }
      </div>
    </div>
  </div>
</div>
