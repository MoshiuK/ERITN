@using Juillet.Web.Mvc.Html
@model AccessManagement.Framework.Events.CredentialPickupEntry
@{
  var indent = ((bool?)ViewBag.indent ?? false) ? "m-l-lg" : string.Empty;
}
<tr>
  <td>
    <div class="@indent">
      @Html.DisplayFor(m => m.Avatar, "CredentialOwnerAvatar")
      <a class="undecorated-link" href="@Url.Action("Credential", "Event", new { id = ViewBag.EventId, credentialId = Model.CredentialId })">
        @Html.DisplayFor(m => m.Name)
      </a>
    </div>
  </td>
  <td class="text-center">
    @if (Model.AccessLevel != null)
    {
      @Html.DisplayFor(m => m.AccessLevel)
    }
  </td>
  <td class="text-center">
    @if (Model.PendingSince != null)
    {
      @Html.DisplayFor(m => m.PendingSince)
    }
  </td>
  <td>
    <div class="pull-right">
      @if (Model.Downloads == null || Model.Downloads.Count == 0)
      {
        <span class="text-danger">NOT AVAILABLE</span>
      }
      else
      {
        <div class="btn-group btn-group-sm">
          <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            @Html.GlyphFa("download") &nbsp; <span class="caret"></span>
          </button>
          <ul class="dropdown-menu">
            @foreach (var download in Model.Downloads)
            {
              <li>
                <a target="_blank" href="@download.ContentUri.ToString()" download="download">@download.FormFactor.Name</a>
              </li>
            }
          </ul>
        </div>
      }
      @using (Html.BeginForm("PickedUp", "Event", new { id = ViewBag.EventId }, FormMethod.Post, new { style = "display: inline" }))
      {
        @Html.AntiForgeryToken()

        <input type="hidden" name="credentialId" value="@Model.CredentialId" />

        <button type="submit" class="btn btn-sm btn-danger" title="Picked Up (Remove item from this list)">
          <span>@Html.GlyphFa("times")</span>
        </button>
      }
    </div>
  </td>
</tr>
