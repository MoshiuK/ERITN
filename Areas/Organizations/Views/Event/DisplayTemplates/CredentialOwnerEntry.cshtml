@using Juillet.Web.Mvc.Html
@model AccessManagement.Framework.Events.CredentialOwnerEntry
@{
  var indent = ((bool?) ViewBag.indent ?? false) ? "m-l-lg" : string.Empty;
}
<tr>
  <td class="text-center" style="vertical-align: middle">
    <input type="checkbox"
           data-roster-entry-type="credential-owner"
           data-member-id="@Model.CorrelationId"
           data-credential-id="@Model.CredentialId"
           data-is-sent="@Model.DistributedOn.HasValue"/>
  </td>
  <td>
    <div class="@indent">
      @Html.DisplayFor(m => m.Avatar, "CredentialOwnerAvatar")
      <small>
        <a title="@Model.Name" class="undecorated-link" href="@Url.Action("Credential", "Event", new {id = ViewBag.EventId, credentialId = Model.CredentialId})">
          @Html.DisplayFor(m => m.Name)
        </a>
      </small>
    </div>
  </td>
  <td>
    <div>
      <a title="@Model.CredentialLocation" class="undecorated-link" href="@Url.Action("Credential", "Event", new { id = ViewBag.EventId, credentialId = Model.CredentialId })">
        <small class="text-muted">
          @{
            var credentialLocation = Model.CredentialLocation.Split(',')[0];
            if (credentialLocation.Length > 19)
            {
              credentialLocation = credentialLocation.Substring(0, 19) + "...";
            }

            @Html.DisplayFor(_ => credentialLocation)
          }
        </small>
      </a>
    </div>
    <div>
      <a title="@Model.CredentialPurpose" class="undecorated-link" href="@Url.Action("Credential", "Event", new { id = ViewBag.EventId, credentialId = Model.CredentialId })">
        <small class="text-muted">
          @{
            var credentialPurpose = Model.CredentialPurpose;
            if (credentialPurpose.Length > 19)
            {
              credentialPurpose = credentialPurpose.Substring(0, 19) + "...";
            }

            @Html.DisplayFor(_ => credentialPurpose)
          }
        </small>
      </a>
    </div>
  </td>
  <td>
    <div>
      <a title="@Model.CredentialType" class="undecorated-link" href="@Url.Action("Credential", "Event", new { id = ViewBag.EventId, credentialId = Model.CredentialId })">
        <small class="text-muted">
          @{
            var credentialType = Model.CredentialType;
            if (credentialType.Length > 19)
            {
              credentialType = credentialType.Substring(0, 19) + "...";
            }

            @Html.DisplayFor(_ => credentialType)
          }
        </small>
      </a>
    </div>
  </td>
  <td class="text-center">
    @if (Model.AccessLevel != null)
    {
      @Html.DisplayFor(m => m.AccessLevel)
    }
  </td>
  <td class="text-center">
    <small>
    @if (Model.DistributedOn != null)
    {
      @Html.DisplayFor(m => m.DistributedOn)
    }
    else if (Model.UnreachableMember)
    {
      <span data-toggle="popover" data-placement="bottom" data-html="true" title="Unreachable Member" data-content='This member is unable to be sent their credentials due to their notification preferences. 
         @Html.ActionLink("View Notification Preferences", "Notifications", "Person", new {id = Model.MemberId}, new {data_toggle = "tooltip", data_placement = "top", title = "Update"}).'>
        @Html.GlyphFa("info-circle")
      </span>
    }
    </small>
  </td>
</tr>
