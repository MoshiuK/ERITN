@model AccessManagement.Web.Areas.Organizations.ViewModels.EventHub.CredentialViewModel
@using AccessManagement.Framework.Credentials.Cerra
@using AccessManagement.Framework.Credentials.ErItn
@using AccessManagement.Web.Areas.Organizations
@using Juillet.Web.Mvc.Html
@{
  Layout = "_EventHubLayout.cshtml";
}
<div class="credential-page">
  <div class="row m-t-sm m-b-sm">
    <div class="col-md-12">
      <a href="@Url.Action("Roster", "Event", new { id = Model.EmergencyEventId, area = OrganizationsAreaRegistration.Name })">
        @Html.GlyphFa("arrow-circle-left") Back to Full Roster
      </a>
    </div>
  </div>
  
  <div class="card">
    <div class="card-content">

      @if (Model.Credential.CredentialPayload is CerraTransitCredentialPayload)
      {
        @Html.DisplayFor(m => m.Credential.CredentialPayload, "Credential/CerraTransitCredentialPayload", new { Model.Credential.MemberCredential, EventId = Model.EmergencyEventId })
      }

      @if (Model.Credential.CredentialPayload is EritnTransitCredentialPayload)
      {
        @Html.DisplayFor(m => m.Credential.CredentialPayload, "Credential/EritnTransitCredentialPayload", new { Model.Credential.MemberCredential, EventId = Model.EmergencyEventId })
      }

    </div>
  </div>

  <div class="row">
    <div class="col-md-12">
      @Html.DisplayFor(m => m.Credential.MemberCredential.CredentialType, new { Model.Credential.MemberCredential, EventId = Model.EmergencyEventId })
    </div>
  </div>
  
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-content">
          <h3>@Html.GlyphFa("list") Activity</h3>
          @Html.DisplayFor(m => m.ActivityStream, new {Model.Credential.MemberCredential, EventId = Model.EmergencyEventId})
        </div>
      </div>
    </div>
  </div>

</div>
