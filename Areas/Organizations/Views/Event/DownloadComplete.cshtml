@using AccessManagement.Web.Areas.Organizations
@using Juillet.Web.Mvc.Html
@model AccessManagement.Framework.Events.DownloadCredentialArchiveSummary
@{
  Layout = "_EventHubLayout.cshtml";
}
<div class="download-progress-page">
  <div class="row m-t-sm m-b-sm">
    <div class="col-md-12">
      <a href="@Url.Action("Roster", "Event", new { id = Model.EmergencyEventId, area = OrganizationsAreaRegistration.Name })">
        @Html.GlyphFa("arrow-circle-left") Back to Full Roster
      </a>
    </div>
  </div>

  <div class="row">
    <div class="col-md-offset-2 col-md-2 text-center">
      <h1 class="text-primary">@Html.GlyphFa("file-archive-o")</h1>
    </div>
    <div class="col-md-8">
      <h3 class="text-primary">Ready to Download</h3>
    </div>
  </div>

  <div class="row">
    <div class="col-md-offset-2 col-md-8">
      <div class="progress">
        <div class="progress-bar progress-bar-striped progress-bar-info" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" style="width: 100%">
          <span class="sr-only">Preparation Completed</span>
          Completed @Html.ValueFor(m => m.CompletedCount) of @Html.ValueFor(m => m.TotalCount) entries with @Html.ValueFor(m => m.ErrorCount) errors.
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-12">
      @Html.DisplayFor(m => m.Entries, "ArchiveEntryTable")
    </div>
  </div>

  <div class="row m-t-md">
    <div class="col-md-offset-1 col-md-10">
      <h3 class="text-primary text-center">Your files are ready to download.</h3>
      <p>
        Use the link below to download a Zip file (compressed folder) that contains the credentials
        you requested for download. Extract the contents of the Zip file to find credentials for your personnel.
      </p>
      <p class="text-muted">
        <small>This link is only valid for 24 hours.</small>
      </p>
    </div>
  </div>
  <div class="row">
    <div class="col-md-1 text-primary">
      @Html.GlyphFa("download", GlyphStyles.X3)
    </div>
    <div class="col-md-10">
      <textarea id="urlTextArea" class="form-control" rows="6" readonly="readonly">@Model.ArchiveInfo.Uri</textarea>
    </div>
  </div>

  <div class="row m-t-sm">
    <div class="col-md-offset-1 col-md-10">
      <div class="pull-right">
        <button id="copyToClipboardButton" class="btn btn-default" type="button">@Html.GlyphFa("files-o") Copy Link</button>
        <a href="@Model.ArchiveInfo.Uri" class="btn btn-primary" download="download">@Html.GlyphFa("download") Download Archive</a>
      </div>
    </div>
  </div>
</div>

@section pagescripts
{
  <script type="text/javascript">
    var textField = $("#urlTextArea")[0];
    $("#copyToClipboardButton").click(function () {
      textField.focus();
      textField.setSelectionRange(0, textField.value.length);
      try {
        document.execCommand("copy");
      } catch (e) {
        console.log(e);
      }
      textField.setSelectionRange(0, 0);
    });
  </script>
}