@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.Areas.Organizations.ViewModels.EventHub.Roster
@{
  ViewBag.EventId = Model.EmergencyEventId;
}
@{
  var startPosition = Model.Personnel.TotalCount == 0 ? 0 : (1 + Model.Personnel.PageIndex * Model.Personnel.PageSize);
  var endPosition = (startPosition - 1) + Model.Personnel.Count;
  var total = Model.Personnel.TotalCount;
}
<div id="rosterList">
  <div class="row">
    <div class="col-md-12">
      <div class="pull-right">
        <span class="text-muted small m-r-lg">Last refreshed <i class="fa fa-clock-o"></i> <time data-juillet-currenttime></time></span>
        <span class="text-muted small">Showing @startPosition - @endPosition of @total items.</span>
      </div>
    </div>
  </div>

  <table class="table table-hover table-condensed">
    <thead>
    <tr>
      <th class="text-center" title="Select" style="width: 72px; padding:0">
        <div class="btn-group">
          <button id="selectAllButton" type="button" class="btn btn-default">@Html.GlyphFa("check-square-o")</button>
          <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <span class="caret"></span>
            <span class="sr-only">Toggle Dropdown</span>
          </button>
          <ul class="dropdown-menu">
            <li><a href="#" id="selectAllMenuItem">All</a></li>
            <li><a href="#" id="selectNoneMenuItem">None</a></li>
            <li><a href="#" id="selectUnsentMenuItem">Unsent</a></li>
            <li><a href="#" id="selectClearedMenuItem">Cleared For Access</a></li>
          </ul>
        </div>
      </th>
      <th>NAME</th>
      <th class="fw-180">LOCATION / PURPOSE</th>
      <th class="fw-180">CREDENTIAL TYPE</th>
      <th class="fw-50 text-center">LEVEL</th>
      <th class="fw-50 text-center">SENT</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var row in Model.Personnel)
    {
      @Html.DisplayFor(_ => row)
    }
    </tbody>
  </table>
  <div class="row m-t-md">
    <div class="col-md-12">
      @if (string.IsNullOrEmpty(Model.Filter))
      {
        @Html.DisplayFor(m => m.Pager)
      }
      else
      {
        <div class="text-center">
          @if (Model.Personnel.TotalCount > Model.Personnel.Count)
          {
            <a class="btn btn-default" href="@Url.Action("Roster", new {id = Model.EmergencyEventId, q = Model.Filter})">
              @Html.GlyphFa("search")
              Show all matches for '@Html.DisplayFor(m => m.Filter)'
            </a>
          }
          <a class="btn btn-default" href="@Url.Action("Roster", new {id = Model.EmergencyEventId})">Back to the full roster</a>
        </div>
      }
    </div>
  </div>
</div>