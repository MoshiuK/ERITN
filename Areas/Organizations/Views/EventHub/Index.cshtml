@model IReadOnlyCollection<AccessManagement.Framework.Events.OrganizationEmergencyEvent>
@{
  Layout = "../Shared/_OrganizationsLayout.cshtml";
}

<div class="events-hub">
  <div class="events-page">
    <div class="row">
      <div class="col-md-12 m-h-15">
        <h2 id="eventHubTour" class="text-primary heading-inline-block">Emergency Events</h2>
      </div>
      <div>
        @if (Model.Count == 0)
        {
          <h2 class="text-muted">No events are available for your organization.</h2>
        }
      </div>
    </div>

    @for (int i = 0; i < Model.Count; i += 2)
    {
      <div class="row">
        <div class="col-md-6">
          @Html.Partial("EventCard", Model.ElementAt(i))
        </div>
        @if (i + 1 < Model.Count)
        {
          <div class="col-md-6">
            @Html.Partial("EventCard", Model.ElementAt(i + 1))
          </div>
        }
      </div>
    }
  </div>
</div>

@if (!ViewBag.HasCompletedEventHubTour)
{
  <script type="text/javascript" src="~/Scripts/spstour.js"></script>
}