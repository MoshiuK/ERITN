@using Juillet.Web.Mvc.Html
@model Juillet.Web.Api.PagedCollection<AccessManagement.Web.Areas.Organizations.ViewModels.PeopleHub.PeopleTableRow>
<table id="peopleList" class="table table-condensed">
  <thead>
  <tr>
    <th class="pw-80">NAME</th>
    <th class="fw-50 text-center">@Html.GlyphFa("id-badge")</th>
    <th>LEVEL</th>
    <th>LOCATION</th>
    <th class="fw-50"></th>
  </tr>
  </thead>
  <tbody>
  @if (Model.Metadata.TotalCount == 0)
  {
    <tr>
      <td colspan="5"><span class="text-muted"><em>No matches found.</em></span></td>
    </tr>
  }
  else
  {
    foreach (var row in Model.Data)
    {
      @Html.DisplayFor(_ => row)
    }    
  }
  </tbody>
</table>
