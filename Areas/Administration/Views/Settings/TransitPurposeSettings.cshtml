@model AccessManagement.Web.Areas.Administration.ViewModels.Settings.TransitPurposeSettingsViewModel
@using Juillet.Web.Mvc.Html
@{
  Layout = "_SettingsTabLayout.cshtml";
}

<div class="row">
  <div class="col-md-12">
    <div class="panel panel-default">
      <div class="panel-heading">
        <div class="panel-title">Transit Purposes / Support Functions</div>
      </div>
      <div class="panel-body">
        <p>
          The support functions listed below will be available for organizations to specify how or why they will respond to an emergency event.  If
          a support function is not available or is marked inactive, it will not be available during registration.
        </p>
        @Html.DisplayFor(m => m.TransitPurposes)
        @if (Model.IsMoreTransitPurposesShown)
        {
          <div class="pull-right">
            <button data-toggle="modal" data-target="#addTransitPurposeDialog" class="btn btn-primary">@Html.GlyphFa("plus") Additional Transit Purposes</button>
            @Html.Action("AddTransitPurposeDialog", new { id = "addTransitPurposeDialog" })
          </div>
        }
      </div>
    </div>
  </div>
</div>
