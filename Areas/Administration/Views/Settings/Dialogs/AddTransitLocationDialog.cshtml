@using System.Web.Mvc.Html
@model AccessManagement.Web.Areas.Administration.ViewModels.AddTransitLocationDialogViewModel
<div id="@Model.DialogId" class="modal fade" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    @using (Html.BeginForm("AddTransitLocation", "Settings", FormMethod.Post))
    {
      @Html.AntiForgeryToken()

      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          <h4 class="modal-title">Add a Transit Location</h4>
        </div>
        <div class="modal-body" style="min-height: 200px">
          <p>The following transit locations are available in the sytem. Click <strong>Add</strong> to make this location available to organizations to transit to or through.
          </p>
          <div class="row">
            <div class="col-md-12">
              <div class="form-group">
                @Html.LabelFor(m => m.TransitLocation)
                @Html.DropDownListFor(m => m.TransitLocation, Model.SelectTransitLocations, new { @class = "select2-component form-control" })
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Add</button>
        </div>
      </div>
    }
  </div>
</div>
