@model List<AccessManagement.Web.Areas.Administration.ViewModels.Settings.ProductViewModel>
@using Juillet.Web.Mvc.Html
@{
  Layout = "_SettingsTabLayout.cshtml";
}

<div class="col-md-12">
  <h3>@Html.GlyphFa("shopping-cart") Products</h3>
</div>

<div class="col-md-12">
  <div class="col-md-10">
    <h5><small>All prices are per person, per term.</small></h5>
    <h5><small>All terms are in months.</small></h5>
  </div>
  <a class="btn btn-success pull-right" href="@Url.Action("AddProduct", "Settings")">@Html.GlyphFa("plus") Add a Product</a>
</div>

<div class="row">
  <div class="col-md-12">
    <div class="panel">
      <div class="panel-body">
        <div id="resultsPane">
          <table class="table table-hover table-striped">
            <thead>
              <tr>
                <th class="text-center">Product Name</th>
                <th class="text-center">Price</th>
                <th class="text-center">Term</th>
                <th class="text-center"># Active Personnel</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              @{
                foreach (var item in Model)
                {
                  @Html.Partial("ProductLine", item);
                  }
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>