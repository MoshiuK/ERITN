@model AccessManagement.Web.Areas.Administration.ViewModels.Organizations.CopyRegistrationLinkViewModel
<div class="modal-dialog" role="document">
  <div class="modal-content">
    <div class="modal-header">
      <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      <h3 class="modal-title">Copy Registration Link</h3>
    </div>
    <div class="modal-body">
      <h4>Click the copy to clipboard button to copy the below registration link to your clipboard.</h4>
      <div class="form-group">
        @Html.LabelFor(m => m.Url)
        @Html.TextBoxFor(m => m.Url, new { @id = "urlTextArea", @class = "form-control", @disabled = "disabled" })
      </div>
      <div class="modal-footer">
        @Html.ActionLink("Copy to Clipboard", "", "", new { url = Model.Url }, new { @id = "copyToClipboardButton", @class = "btn btn-primary" })
      </div>
    </div>
  </div>
</div>

<script>
  var textField = $("#urlTextArea")[0];
  $("#copyToClipboardButton").click(function () {
    try {
      document.getElementById("urlTextArea").disabled = '';
      var copyText = document.getElementById("urlTextArea");
      copyText.select();
      document.execCommand("copy");
      document.getElementById("urlTextArea").disabled = 'true';
    } catch (e) {
      console.log(e);
    }
  });
</script>