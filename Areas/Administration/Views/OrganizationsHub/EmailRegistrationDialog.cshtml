@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.Areas.Administration.ViewModels.Organizations.EmailRegistrationFormViewModel

@using (Html.BeginForm("EmailRegistrationForm", "OrganizationsHub", new { emailAddress = Model.EmailAddress, organizationName = Model.OrganizationName }, FormMethod.Post))
{
  @Html.AntiForgeryToken()

  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h3 class="modal-title">Send Invitation to Register</h3>
      </div>
      <div class="modal-body">
        <h4>Send an email to the specified address with instructions on how to complete the enrollment process.</h4>
        <div class="form-group">
          @Html.ValidationMessageFor(m => m.EmailAddress)
          @Html.LabelFor(m => m.EmailAddress)
          @Html.EditorFor(m => m.EmailAddress)
        </div>
        <div class="form-group">
          @Html.ValidationMessageFor(m => m.OrganizationName)
          @Html.LabelFor(m => m.OrganizationName)
          @Html.EditorFor(m => m.OrganizationName)
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-success">@Html.GlyphFa("check") Send Email</button>
        </div>
      </div>
    </div>
  </div>
}

