@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.Areas.Administration.ViewModels.Organizations.DirectoryPageSummaryLine
<tr>
  <td>
    <div class="row">
      <div class="col-sm-2">
        <a href="@Url.Action("Index", "Organization", new { id = Model.CorrelationId })">
          @Html.DisplayFor(m => m.Avatar)
        </a>
      </div>
      <div class="col-sm-10">
        <div class="row">
          <h4 class="heading-inline-block"><a data-sps-resource-id="@Model.CorrelationId" href="#" data-sps-action>@Html.DisplayFor(m => m.Name)</a></h4>
          <div class="pull-right">
            @if (Model.TotalLicenses - Model.PersonnelCount < 0)
            {
              @Html.GlyphFa("circle", GlyphStyles.FixedWidth, cssClasses: "text-warning")
            }
            else if (Model.Active)
            {
              @Html.GlyphFa("circle", GlyphStyles.FixedWidth, cssClasses: "text-success")
            }
            else
            {
            @Html.GlyphFa("circle", GlyphStyles.FixedWidth, cssClasses: "text-muted")
            }
          </div>
        </div>
        <div class="row">
          <small class="text-muted">@Model.Profile.StreetAddress</small>
          <div class="pull-right">
            <small class="text-muted">@Html.DisplayFor(m => m.ReferenceId)</small>
          </div>
        </div>
        <div class="row">
          <small class="text-muted">@Html.DisplayFor(m => m.Profile.BusinessContactName)</small>
        </div>
      </div>
    </div>
  </td>
  <td class="text-center">
    <h4 class="heading-inline-block"><strong>@Html.DisplayFor(m => m.PersonnelCount)</strong>/<strong>@Html.DisplayFor(m => m.RemainingLicenses)</strong></h4>
  </td>
  <td class="text-center">
    <h4 class="heading-inline-block"></h4>
  </td>
</tr>
