@model AccessManagement.Web.Areas.Administration.ViewModels.Reports.OrganizationSummary

<div class="panel">
  <div class="panel-body">
    <div class="row">
      <div class="col-md-10">
        <h4 class="heading-inline-block"><strong>@Html.DisplayFor(m => m.OrganizationName)</strong></h4>
        <div class="pull-right">
          @if (Model.OrganizationActive)
          {
            <div class="label label-success">ACTIVE</div>
          }
          else
          {
            <div class="label label-default">INACTIVE</div>
          }
        </div>
      </div>
    </div>
    <div class="row m-t-sm">
      <div class="col-md-2">
        <img class="img-circle" src="@Model.Avatar.Thumbnail" alt="Logo for @Html.ValueFor(m => m.OrganizationName)" />
      </div>
      <div class="col-md-6">
        <strong>@Html.DisplayFor(m => m.OrganizationContactName)</strong> <br />
        @Html.DisplayFor(m => m.OrganizationContactPhone) <br />
        @Html.DisplayFor(m => m.OrganizationContactAddress) <br />
        <a href="@Html.ValueFor(m => m.OrganizationContactEmail)">@Html.DisplayFor(m => m.OrganizationContactEmail)</a> <br />
        @if (Model.PurposeList.Length > 0)
        {
          <hr />
          <h4>Assigned Transit Purposes</h4>
          @Html.DisplayFor(m => m.PurposeList) <br />
        }
      </div>
      <div class="col-md-2">
        @foreach (var item in Model.AccessLevelSummaries)
        {
          @Html.Partial("DisplayTemplates/AccessLevelSummaries", item)
        }
      </div>
    </div>
  </div>
</div>