@using AccessManagement.Framework.Tenants
@model AccessManagement.Models.Emergency.CredentialActivity
@functions
{

  string LookupAccessLevelCaption(Guid? id)
  {
    var lookups = (ITenantLookupTables) ViewBag.TenantLookups;
    if (id.HasValue)
    {
      return lookups.AccessLevels[id.Value].LevelMoniker;
    }
    return "(unknown)";
  }
}

<tr>
  <td>
    <span class="m-l-md">
      @Html.DisplayFor(m => m.CredentialActivityType.Name)
    </span>
  </td>
  <td>@Html.DisplayFor(m => m.OccurredAt)</td>
  <td>@Html.DisplayFor(m => m.MemberCredential.Member.Name)</td>
  <td class="md-c">@LookupAccessLevelCaption(Model.MemberCredential.AccessLevel)</td>
  <td>@Html.DisplayFor(m => m.MemberCredential.ReferenceId)</td>
  <td>@Html.DisplayFor(m => m.Location)</td>
  <td>@Html.DisplayFor(m => m.Remarks)</td>
</tr>
