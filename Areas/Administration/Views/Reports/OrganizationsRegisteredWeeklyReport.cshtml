@model IReadOnlyCollection<AccessManagement.Web.ViewModels.Framework.Reports.ReportDataRow>

@{
  Layout = "../Shared/_HubLayout.cshtml";

  ViewBag.ColumnCount = 8;
}

<h2>@ViewBag.Title</h2>
<small>Found @Model.Count report rows.</small>

<div class="table-scroll-container">
  <table class="table table-condensed table-bordered">
    <thead>
      <tr>
        <th class="md-l">Organization Name</th>
        <th class="md-l">Date Registered</th>
        <th class="md-l">Business Contact Name</th>
        <th class="md-l">Business Contact Email</th>
        <th class="md-l">Business Contact Phone</th>
        <th class="md-l">Product Ordered</th>
        <th class="md-l">Quantity of Order</th>
        <th class="md-l">Grand Total of Order</th>
        <th class="md-l">Payment Outstanding</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var row in Model)
      {
        @Html.DisplayFor(_ => row.Data, row.DataTemplate);
      }
    </tbody>
  </table>
</div>
