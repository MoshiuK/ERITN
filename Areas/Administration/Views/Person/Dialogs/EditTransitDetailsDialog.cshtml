@model AccessManagement.Web.Areas.Administration.ViewModels.PeopleHub.EditTransitDetailsDialog
<div class="modal-dialog" role="document">
  @using (Html.BeginForm("SetTransitDetails", "Person", FormMethod.Post))
  {
    @Html.AntiForgeryToken()

    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title">Set transit details</h4>
      </div>
      <div class="modal-body" style="min-height: 200px">
        <p>
          Change the assigned transit details by selecting from the following access levels, transit locations and purposes. Click <strong>Save</strong> to assign the settings.
        </p>
        <div id="initial-selection-info"
             data-access-level-id="@Html.ValueFor(m => m.AccessLevelId)"
             data-access-level-name="@Html.ValueFor(m => m.AccessLevelName)"
             data-location-id="@Html.ValueFor(m => m.LocationId)"
             data-location-name="@Html.ValueFor(m => m.LocationName)"
             data-purpose-id="@Html.ValueFor(m => m.PurposeId)"
             data-purpose-name="@Html.ValueFor(m => m.PurposeName)">
        </div>
        <div class="row">
          <div class="col-md-12">
            @Html.HiddenFor(m => m.MemberId)
            @Html.HiddenFor(m => m.OrganizationId)
            @Html.EditorForModel()
          </div>
        </div>          
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </div>
  }
</div>
