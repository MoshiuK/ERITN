@using AccessManagement.Web.Areas.Administration.ViewModels.PeopleHub
@using Juillet.Web.Mvc.Html
@model PersonCredentials
@{
  Layout = "_PersonTabLayout.cshtml";
}

@{
  var activeCredentialsCss = Model.ActivePaneShown ? "active" : string.Empty;
  var archiveCredentialsCss = Model.ActivePaneShown ? string.Empty : "active";
}

<div class="row m-t-md">
  <div class="col-md-offset-2 col-md-8">
  <ul class="nav nav-tabs nav-justified" role="tablist">
    <li role="presentation" class="@activeCredentialsCss"><a href="#activeCredentials" aria-controls="activeCredentials" role="tab" data-toggle="tab">Credentials for Active Events</a></li>
    <li role="presentation" class="@archiveCredentialsCss"><a href="#archivedCredentials" aria-controls="archivedCredentials" role="tab" data-toggle="tab">Credentials for Archived Events</a></li>
  </ul>
  </div>
</div>

@helper RenderPlaceholder(CredentialPlaceholder placeholder)
{
  if (placeholder.IsPending)
  {
    <div class="card">
      <div class="card-content text-muted">
        <h3 class="text-center">@placeholder.EventName</h3>
        <h4 class="text-center">@placeholder.JurisdictionName</h4>
        <h4 class="text-center">@Html.GlyphFa("clock-o", GlyphStyles.X3)</h4>
        <small>
          We are working on issuing credentials for recently activated <strong>@placeholder.EventName</strong> event. It
          normally takes a few minutes for credentials to appear after an event is activated. <br/>
          We will notify credential holders once the credential is ready.
        </small>
        <small>
          If you prefer, refresh this page after waiting a few minutes.
        </small>
      </div>
    </div>
    return;
  }

  if (placeholder.IsUnavailable)
  {
    <div class="card">
      <div class="card-content text-muted">
        <h3 class="text-center">@placeholder.EventName</h3>
        <h4 class="text-center">@placeholder.JurisdictionName</h4>
        <h4 class="text-center">@Html.GlyphFa("info-circle", GlyphStyles.X3)</h4>
        <small>
          No credential is available for this event.
        </small>
      </div>
    </div>
  }
}

@helper RenderCredential(CredentialSummary credential)
{
  <div class="card">
    <div class="card-content">
      <h3 class="text-center">@credential.EmergencyEvent.Name</h3>
      <h4 class="text-center">@credential.CredentialType.Name</h4>
      <div class="row m-t-md">
        <div class="col-sm-6 text-center">
          @if (credential.IssuingOrganization != null)
          {
            @Html.DisplayFor(_ => credential.IssuingOrganizationAvatar)
            @Html.DisplayFor(_ => credential.IssuingOrganization.Name)
          }
        </div>
        <div class="col-sm-6">
          @if (credential.IssuingJurisdiction != null)
          {
            <h4 class="text-center">@credential.IssuingJurisdiction.Name</h4>
            @Html.DisplayFor(_ => credential.IssuingJurisdictionAvatar)
          }
        </div>
      </div>
      <div class="row m-t-md">
        <div class="col-md-12">
          @Html.DisplayFor(_ => credential.AccessLevel)
        </div>
      </div>
    </div>
    <div class="card-footer">
      <ul class="nav nav-pills">
        <li><a class="m-t-sm" href="@Url.Action("Credential", "PeopleHub", new { id = credential.CorrelationId })">@Html.GlyphFa("ellipsis-h") Details</a></li>
      </ul>
    </div>
  </div>  
}

<div class="row">
  <div class="col-md-12">
    <div class="panel">
      <div class="panel-body">
        <div class="tab-content">
          <div role="tabpanel" class="tab-pane @activeCredentialsCss" id="activeCredentials">
            <div class="row">
              @if (Model.PlaceholderCredentials.Count > 0)
              {
                var placeholders = Model.PlaceholderCredentials.ToArray();
                for (var i = 0; i < placeholders.Length; i += 2)
                {
                  var left = placeholders[i];
                  <div class="col-md-6">
                    @RenderPlaceholder(left)
                  </div>

                  if (i + 1 < placeholders.Length)
                  {
                    var right = placeholders[i + 1];
                    <div class="col-md-6">
                      @RenderPlaceholder(right)
                    </div>
                  }
                }
                <hr />
              }
              @if (Model.ActiveCredentials.Count > 0)
              {
                var actives = Model.ActiveCredentials.ToArray();
                for (var i = 0; i < actives.Length; i += 2)
                {
                  var left = actives[i];
                  <div class="col-md-6">
                    @RenderCredential(left)
                  </div>

                  if (i + 1 < actives.Length)
                  {
                    var right = actives[i + 1];
                    <div class="col-md-6">
                      @RenderCredential(right)
                    </div>
                  }
                }
              }
            </div>
          </div>
          <div role="tabpanel" class="tab-pane @archiveCredentialsCss" id="archivedCredentials">
            <div class="row">
              @if (Model.ArchivedCredentials.Count > 0)
              {
                var creds = Model.ArchivedCredentials.ToArray();
                for (var i = 0; i < creds.Length; i += 2)
                {
                  var left = creds[i];
                  <div class="col-md-6">
                    @RenderCredential(left)
                  </div>

                  if (i + 1 < creds.Length)
                  {
                    var right = creds[i + 1];
                    <div class="col-md-6">
                      @RenderCredential(right)
                    </div>
                  }
                }
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
