@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.Areas.Administration.ViewModels.AccessHub.TemporaryCredentialViewModel

<div class="row border-bottom">
  <div class="col-md-12 text-center">
    <div class="pull-left">
      <div class="m-t-sm">
        <a class="m-t-sm" href="@Url.Action("Credentials", "AccessHub")">@Html.GlyphFa("arrow-circle-left") Back to Credentials</a>
      </div>
    </div>
  </div>
</div>

<div class="row m-t-sm">
  <div class="col-md-12">
    <a class="btn btn-info btn-sm pull-right" role="button" data-toggle="collapse" href="#attributesPanel" aria-expanded="false" aria-controls="attributesPanel">
      @Html.GlyphFa("chevron-down")
    </a>
    <h2 class="text-center">Temporary Credential</h2>
    <div class="collapse" id="attributesPanel">
      <div class="well">
        @if (Model.Attributes == null)
      {
        <div class="alert alert-warning">No additional information about this credential.</div>
    }
    else
    {
      <table class="table">
        <thead>
          <tr>
            <th>NAME</th>
            <th>VALUE</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var next in Model.Attributes)
        {
          <tr>
            <td>@next.Key</td>
            <td>@next.Value</td>
          </tr>
      }
        </tbody>
      </table>
  }
      </div>
    </div>
  </div>
</div>


<div class="row m-t-lg">
  <div class="col-md-12 border-black">
    <img style="width: 100%;" src="@Html.DisplayFor(m => m.ContentUri)" alt="" />
  </div>
</div>

<div class="row">
  <div class="col-md-12 m-t-lg">
    <a href="@Url.Action("NewCredential")" class="btn btn-primary pull-right">Create Another Credential</a>
  </div>
</div>
