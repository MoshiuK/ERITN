@model AccessManagement.Web.Areas.Administration.ViewModels.AccessHub.NewCredential
@using Juillet.Web.Mvc
@using Juillet.Web.Mvc.Html
@{
  Layout = "../Shared/_AdministrationLayout.cshtml";
  var menuBar = (NavBar)ViewBag.MenuBar ?? new NavBar();
  var returnUrl = (string)ViewBag.ReturnUrl ?? this.Url.Action("Credentials", "AccessHub");
}

<div class="row">
  <div class="col-md-12 text-center">
    <h1>New Credential</h1>
  </div>
</div>

@if (ViewBag.Alert != null)
{
  <div class="row">
    <div class="col-md-12">
      <div class="alert alert-danger alert-dismissible text-center">@Html.GlyphFa("exclamation-triangle") @ViewBag.Alert</div>
    </div>
  </div>
}

@using (Html.BeginForm("NewCredential", "AccessHub", null, FormMethod.Post, new {@class = "form-horizontal"}))
{
  @Html.AntiForgeryToken()

  <div class="row">
    <div class="col-lg-offset-2 col-md-8">
      @Html.EditorForModel()
    </div>
  </div>

  <div class="row">
    <div class="col-lg-offset-2 col-md-8">
      <div class="m-t-lg pull-right">
        <button type="submit" class="btn btn-primary btn-lg">Create</button>
        <a class="btn btn-default m-l-lg" href="@returnUrl">Cancel</a>
      </div>
    </div>
  </div>
}