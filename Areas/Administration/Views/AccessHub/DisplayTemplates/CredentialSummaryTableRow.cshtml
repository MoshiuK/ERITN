@model AccessManagement.Web.Areas.Administration.ViewModels.AccessHub.CredentialSummaryTableRow
<tr>
  <td>
    <a href="@Url.Action("Index", "Credential", new { id = Model.CredentialId })">
      @Html.DisplayFor(m => m.MemberName)
    </a><br />
    <small class="text-muted">@Html.DisplayFor(m => m.OrganizationName)</small>
  </td>
  <td>
    @Html.DisplayFor(m => m.AccessLevel)
    @Html.DisplayFor(m => m.CredentialType)
  </td>
  <td>
    <span>@Html.DisplayFor(m => m.EventName)</span><br />
    <small class="text-muted">@Html.DisplayFor(m => m.JurisdictionName)</small>
  </td>
  <td>
    @Html.DisplayFor(m => m.IssueDate)
  </td>
</tr>
