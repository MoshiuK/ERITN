@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.Areas.Administration.ViewModels.AccessHub.CredentialsPageViewModel
@{
  Layout = "../Shared/_HubLayout.cshtml";
}
<div class="pull-right">
  <a class="btn btn-primary btn-lg" href="@Url.Action("NewCredential")">
    @Html.GlyphFa("plus") Create New Credential
  </a>
</div>

<table class="table m-t-md">
  <thead>
  <tr>
    <th class="fw-200">CREDENTIAL OWNER</th>
    <th>CREDENTIAL TYPE</th>
    <th>EVENT</th>
    <th>ISSUE DATE</th>
  </tr>
  </thead>
  <tbody>
  @foreach (var row in Model.Credentials)
  {
    @Html.DisplayFor(_ => row)
  }
  </tbody>
</table>
