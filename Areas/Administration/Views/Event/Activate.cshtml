@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.Areas.Administration.ViewModels.AccessHub.EventActivationViewModel
@{
  Layout = "_EventTabLayout.cshtml";
}

<div class="row">
  <div class="col-md-12 text-center">
    <h3 class="text-danger">Confirm you want to activate this event.</h3>
  </div>
</div>

<div class="row m-t-lg">
  <div class="col-md-12">
    <div class="panel panel-danger">
      <div class="panel-body">
        <div class="row">
          <div class="col-md-2">
              @Html.GlyphFa("bullhorn", GlyphStyles.X4, cssClasses: "text-danger")
          </div>
          <div class="col-md-10">
            <p class="text-danger">
              Activate an event to evaluate, issue and distribute access credentials that provide access to restricted areas of the emergency zone.
            </p>
            <p class="text-danger">
              <strong>The following steps will be performed for <em>all organizations</em> and <em>all personnel</em>.</strong>
            </p>
            <ul class="list-unstyled text-danger m-l-md">
              <li>@Html.GlyphFa("retweet", GlyphStyles.FixedWidth) Evaluate personnel that are cleared for this event.</li>
              <li>@Html.GlyphFa("ticket", GlyphStyles.FixedWidth) Issue credentials for registered personnel with access level.</li>
              <li>@Html.GlyphFa("envelope", GlyphStyles.FixedWidth) Distribute credentials to personnel, based on their preferences.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
    <div class="col-md-12">
      <div class="panel">
        <div class="panel-body">
          @using (Html.BeginForm("Activate", "Event", null, FormMethod.Post, new { id = "activationForm" }))
          {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.CorrelationId)

          <div class="m-t-md text-center">
            <div class="alert alert-danger m-b-lg"><strong>ACTIVATION CANNOT BE REVERSED</strong></div>
            <a href="@Url.Action("Index", new {id = Model.CorrelationId})" class="btn btn-default">Do Not Activate</a>
            <button type="submit" class="btn btn-success btn-lg">Activate Event Now</button>
          </div>
          }
        </div>
      </div>
    </div>
  </div>
