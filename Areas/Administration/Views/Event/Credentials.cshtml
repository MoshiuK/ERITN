@using System.Web.Mvc.Html
@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.Areas.Administration.ViewModels.AccessHub.EventMemberCredentialsViewModel
@{
  Layout = "_EventTabLayout.cshtml";
}

@{
  var startPosition = (Model.PageOfContent.Metadata.TotalCount == 0) ? 0 : Model.PageOfContent.Metadata.StartPosition;
  var endPosition = Model.PageOfContent.Metadata.EndPosition;
  var total = Model.PageOfContent.Metadata.TotalCount;
}

<div class="row">
  <div class="col-md-12">
    <div class="panel">
      <div class="panel-body">
        <span class="text-muted small pull-right">Last refreshed <i class="fa fa-clock-o"></i> <time data-juillet-currenttime></time></span>
        <h2>Find Credentials</h2>
        @Html.Partial("Forms/FilterForm", Model.Filter)
        <div>
          <span class="pull-right small text-muted">Showing @startPosition - @endPosition of @total items.</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    <div class="panel">
      <div class="panel-body">
        <div id="resultsPane">
          <table class="table">
            <thead>
              <tr>
                <th class="fw-200"><small>NAME</small></th>
                <th><small>CREDENTIAL TYPE</small></th>
                <th><small>ISSUANCE</small></th>
              </tr>
            </thead>
            <tbody>
            @{
              foreach (var item in Model.PageOfContent.Data)
              {
                @Html.Partial("DisplayTemplates/MemberCredentialTableRow", item);
              }
            }
            </tbody>
          </table>
        </div>
        @Html.DisplayFor(m => m.Pager)
      </div>
    </div>
  </div>
</div>

@section pagescripts
{
  <script src="~/Scripts/pages/administration.event.credentials.js"></script>
}
