@model IReadOnlyCollection<AccessManagement.Models.Emergency.CredentialType>
<span class="text-muted"><small>@Model.Count supported credentials</small></span>
<table class="table">
  <thead>
    <tr>
      <th>#</th>
      <th>NAME</th>
      <th>VALUE TYPE</th>
      <th>FORM FACTORS</th>
      <th class="fw-80">ACTIONS</th>
    </tr>
  </thead>
  <tbody>
    @foreach (var item in Model.OrderBy(m => m.Name))
    {
      @Html.DisplayFor(_ => item, "CredentialTypeTableRow", new { eventId = ViewBag.eventId })
    }
  </tbody>
</table>

