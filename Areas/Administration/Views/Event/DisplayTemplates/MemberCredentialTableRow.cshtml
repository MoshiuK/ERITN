@model AccessManagement.Web.Areas.Administration.ViewModels.AccessHub.EventMemberCredentialTableRow
<tr>
  <td>
    @Html.DisplayFor(m => m.MemberCredential.Member.Name)
  </td>
  <td>
    @(Model.AccessLevel == null ? Html.Raw("-") : Html.DisplayFor(m => m.AccessLevel))<br/>
    <small>@Html.DisplayFor(m => m.MemberCredential.CredentialType.Name)</small>
  </td>
  <td>
    @(Model.Organization == null ? Html.Raw("-") : Html.DisplayFor(m => m.Organization, "OrganizationInfo"))
    @(Model.EventLocation == null ? Html.Raw("-") : Html.DisplayFor(m => m.EventLocation))
  </td>
</tr>
