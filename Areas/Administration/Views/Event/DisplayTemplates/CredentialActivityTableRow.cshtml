    <small>
      @Html.DisplayFor(m => m.Activity.MemberCredential.Member.Name)
    </small>
  </td>
  <td>
    <small>
      @Html.DisplayFor(m => m.Activity.CustomText3)
    </small>
  </td>
  <td>
    <small>
      @Html.DisplayFor(m => m.Activity.CredentialActivityType.Name)
    </small>
  </td>
  <td>
    <small>
      @Html.DisplayFor(m => m.Activity.OccurredAt)
    </small>
  </td>
  <td>
    <small>
      @Html.DisplayFor(m => m.Activity.Location)
    </small>
  </td>
  <td>
    <small>
      @Html.DisplayFor(m => m.Activity.Remarks)
