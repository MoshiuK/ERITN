@using Juillet.Web.Mvc.Html
@model AccessManagement.Models.Emergency.CredentialType
<div class="m-b-sm">
  <span><strong>@Html.DisplayFor(m => m.Name)</strong> <small class="text-muted">@Html.DisplayFor(m => m.Description)</small></span>
  <div>
    @foreach (var ff in Model.FormFactors)
    {
      <div class="label label-white border m-r-sm">
        <small class="text-primary">@Html.GlyphFa("id-badge") @ff.CredentialFormFactor.Name &nbsp;</small>
      </div>
    }
  </div>
</div>

