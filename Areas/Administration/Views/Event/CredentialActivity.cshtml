@model AccessManagement.Web.Areas.Administration.ViewModels.CredentialActivityStream
@{
  Layout = "_EventTabLayout.cshtml";
}

@{
  var startPosition = (Model.PageOfContent.Metadata.TotalCount == 0) ? 0 : Model.PageOfContent.Metadata.StartPosition;
  var endPosition = Model.PageOfContent.Metadata.EndPosition;
  var total = Model.PageOfContent.Metadata.TotalCount;
}

<div class="row">
  <div class="col-md-12">
    <div class="panel">
      <div class="panel-body">
        <span class="text-muted small pull-right">Last refreshed <i class="fa fa-clock-o"></i> <time data-juillet-currenttime></time></span>
        <h2>Find Activities</h2>
        @Html.Partial("Forms/FilterForm", Model.Filter)
        <div>
          <span class="pull-right small text-muted">Showing @startPosition - @endPosition of @total items.</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div>
  <ul class="nav nav-tabs nav-justified" role="tablist">
    <li id="credentialActivityTableButton" class="active" role="presentation"><a href="#table" aria-controls="table" role="tab" data-toggle="tab">Credential Activity Table</a></li>
    <li id="credentialActivityMapButton" role="presentation"><a href="#map" aria-controls="map" role="tab" data-toggle="tab">Credential Activity Map</a></li>
  </ul>
</div>

<div class="row">
  <div class="col-md-12">
    <div class="panel">
      <div class="panel-body">
        <div class="tab-content">
          <div role="tabpanel" class="tab-pane active" id="table">
            <div class="row">
              @Html.Partial("ActivitiesTable", Model)
            </div>
          </div>
          <div role="tabpanel" class="tab-pane" id="map">
            <div class="row">
              @Html.Partial("CredentialActivityMap", Model)
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>