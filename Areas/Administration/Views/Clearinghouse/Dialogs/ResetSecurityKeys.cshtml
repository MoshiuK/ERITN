@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.Areas.Administration.ViewModels.Clearinghouse.ResetSecurityKeysDialog
<div class="modal-dialog" role="document">
  @using (Html.BeginForm("OrganizationsResetKeys", "Clearinghouse", FormMethod.Post))
  {
    @Html.AntiForgeryToken()

    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title">Reset Security Keys</h4>
      </div>
      <div class="modal-body" style="min-height: 200px">
        <p>
          Choose when the newly created keys will expire.  1-3 years from now is recommended.
        </p>
        <div class="row">
          <div class="col-md-12">
            <div class="form-group">
              @Html.LabelFor(m => m.ValidUntil)
              @Html.EditorFor(m => m.ValidUntil)
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-md-12">
            <div class="alert alert-danger">
              @Html.GlyphFa("exclamation-triangle") Resetting security keys will break connections until new settings are applied by CERRA Clearinghouse support personnel.
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Reset Now</button>
      </div>
    </div>
  }
</div>
