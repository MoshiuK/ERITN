@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.Areas.Administration.ViewModels.PeopleHub.CredentialGeneralSettings
@{
  Layout = "_CredentialTabLayout.cshtml";
}

<div class="row">
  <div class="col-md-12 text-center">
    <h3>@Html.DisplayFor(m => m.EmergencyEvent.Name)</h3>
  </div>
</div>

<div class="row">
  <div class="col-md-7">
    <div class="row">
      <div class="col-md-2">
        @Html.DisplayFor(m => m.IssuingJurisdictionAvatar)
      </div>
      <div class="col-md-5">
        <h2>
          @Html.DisplayFor(m => m.IssuingJurisdiction.Name)
        </h2>
      </div>
    </div>
    <div class="row">
      <div class="col-md-2">
        @Html.DisplayFor(m => m.IssuingOrganizationAvatar)
      </div>
      <div class="col-md-6">
        <h2>
          @Html.DisplayFor(m => m.IssuingOrganization.Name)
        </h2>
      </div>
    </div>
    <div class="row m-t-md">
      <div class="col-md-12">
        @Html.DisplayFor(m => m.AccessLevel)
      </div>
    </div>
  </div>
  <div class="col-md-5">
    <div class="well">
      <h5 class="text-center"><strong>DOWNLOADS</strong></h5>
      <ul class="list-unstyled">
        @foreach (var cf in Model.DownloadLinks)
        {
          @Html.DisplayFor(_ => cf)
        }
      </ul>
    </div>
    <div class="well m-t-lg text-center">
      <h5><strong>DISTRIBUTION</strong></h5>
      @if (Model.DistributedOn.HasValue)
      {
        @Html.LabelFor(m => m.DistributedOn)
        <span>&nbsp;</span>
        @Html.DisplayFor(m => m.DistributedOn)
      }
      else
      {
        if (!ViewBag.IsRecentlySaved)
        {
          <span class="text-muted">This credential has never been sent.</span>
        }
      }

      @if (ViewBag.IsRecentlySaved)
      {
        <span><br />@Html.GlyphFa("paper-plane") Credential was sent.</span>
      }
      else
      {
        using (Html.BeginForm("Send", "Credential", new {id = Model.CorrelationId}, FormMethod.Post, null))
        {
          @Html.AntiForgeryToken()

          <button type="submit" class="btn btn-primary">@Html.GlyphFa("paper-plane") Send Credential</button>
        }
      }
    </div>
    <div class="well m-t-lg text-center">
      <h5><strong>ACTIONS</strong></h5>
      <div class="table">
        <div class="row">
          @{
            <div class="col-md-6">
              @using (Html.BeginForm("TerminateAsync", "Credential", new { id = Model.CorrelationId }, FormMethod.Post, null))
              {
                @Html.AntiForgeryToken()
              <button type="submit" class="btn btn-warning btn-block">Terminate</button>
              }
            </div>
            <div class="col-md-6">
              @using (Html.BeginForm("DeleteAsync", "Credential", new { id = Model.CorrelationId }, FormMethod.Post, null))
              {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger btn-block">Delete</button>
              }
            </div>
          }
        </div>
      </div>
    </div>
  </div>
</div>