@using AccessManagement.Models.Emergency
@using AccessManagement.Web.Services
@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.Areas.Administration.ViewModels.CredentialActivityStream

@functions
{
  string GlyphForActivityType(int type)
  {
    var uiSupport = (ICredentialActivityViewSupport)ViewBag.UiSupport;
    return uiSupport.GetGlyphFor(type);
  }

  string CssClassForActivityType(int type)
  {
    var uiSupport = (ICredentialActivityViewSupport)ViewBag.UiSupport;
    var brand = uiSupport.GetBootstrapBrandFor(type);
    var css = string.Empty;
    switch (brand)
    {
      case BootstrapBrands.Success:
        css = "bg-success";
        break;
      case BootstrapBrands.Info:
        css = "bg-info";
        break;
      case BootstrapBrands.Warning:
        css = "bg-warning";
        break;
      case BootstrapBrands.Danger:
        css = "bg-danger";
        break;
    }
    return css;
  }

  string ActionStatementForActivity(CredentialActivity activity)
  {
    var uiSupport = (ICredentialActivityViewSupport)ViewBag.UiSupport;
    return uiSupport.GetActivitySummaryFromActivity(activity);
  }

}

@if (!Model.PageOfContent.Data.Any())
{
  <div class="row">
    <div class="col-md-12 text-center">
      <h4 class="text-muted">No activity found.</h4>
    </div>
  </div>
}
else
{
  foreach (var activity in Model.PageOfContent.Data)
  {
    var action = ActionStatementForActivity(activity.Activity);
    var cssClass = CssClassForActivityType(activity.Activity.CredentialActivityTypeId);
    <div id="@activity.Activity.ActivityId" class="media stream-item">
      <div class="media-left stream-item-badge-square">
        <div href="#">
          @Html.GlyphFa(GlyphForActivityType(
            activity.Activity.CredentialActivityTypeId),
            cssClasses: cssClass)
        </div>
      </div>
      <div class="media-body">
        <h6 class="m-l-lg">
          <b>@(activity.Activity.CustomText3 ?? "Unknown")</b> @action at @(activity.Activity.Location ?? "unknown").
          <small class="pull-right">@Html.DisplayFor(_ => activity.TimeAgo)</small>
        </h6>
        @Html.DisplayFor(_ => activity.Activity.Remarks)
      </div>
    </div>
  }
  @Html.DisplayFor(m => m.Pager)
}