@using AccessManagement.Web.Mvc
@model AccessManagement.Web.Areas.Administration.ViewModels.CredentialActivityStream

@{
  Layout = "../Shared/_AdministrationLayout.cshtml";
}

@if (!Model.PageOfContent.Data.Any())
{
  <div class="row">
    <div class="col-md-12 text-center">
      <h4 class="text-muted">No activity found.</h4>
    </div>
  </div>
}
else
{
  <div class="border" id="activityMap"></div>

  <div>
    <table id="activityTable" class="table table-condensed table-hover">
      <tbody>
      @foreach (var activity in Model.PageOfContent.Data)
      {
        var geoAttrs = $"data-has-marker " +
                       $"data-marker-activityType={activity.Activity.CredentialActivityType.ValueType}" +
                       $" data-marker-lat={activity.Latitude ?? "(none)"}" +
                       $" data-marker-lng={activity.Longitude ?? "(none)"}" +
                       $" data-marker-id={activity.Activity.ActivityId} " +
                       $" data-marker-membername={activity.Activity.MemberCredential.Member.Name?.Replace(" ", "%20") ?? "Unknown"}"  +
                       $" data-marker-officer={activity.Activity.CustomText3?.Replace(" ", "%20") ?? "Unknown"}"  +
                       $" data-marker-time-ago={activity.TimeAgo?.Replace(" ", "%20") ?? "Unknown"}" +
                       $" data-marker-remarks={activity.Activity.Remarks?.Replace(" ", "%20") ?? "Unknown"}"  +
                       $" data-marker-date={activity.Activity.OccurredAt.UtcDateTime:o}";

        <tr @geoAttrs></tr>
      }
      </tbody>
    </table>
  </div>

  @section scripts
  {
    <script src="~/Scripts/pages/administration.credential.activity.map.js"></script>
    @Html.ScriptForGooglePlacesAutoComplete()
  }

  @section styles
  { 
    <style type="text/css">
      #activityMap {
        margin-top: 10px;
        margin-left: 0px;
        height: 480px;
        width: 100%;
      }
    </style>
  }
}
