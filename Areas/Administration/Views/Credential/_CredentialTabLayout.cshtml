@using AccessManagement.Web.Areas.Administration.ViewModels.AccessHub
@using Juillet.Web.Mvc
@using Juillet.Web.Mvc.Html
@{
  Layout = "../Shared/_AdministrationLayout.cshtml";
  var menuBar = (NavBar)ViewBag.MenuBar ?? new NavBar();
  var sideBar = (CredentialSideBarViewModel)ViewBag.SideBar;
}

@section styles
{
  @RenderSection("pagestyles", false)
}

<div class="row border-bottom">
  <div class="col-md-12 text-center">
    <div class="pull-left">
      <div class="m-t-sm">
        <a class="m-t-sm" href="@Url.Action("Credentials", "AccessHub")">@Html.GlyphFa("arrow-circle-left") Back to Credentials</a>
      </div>
    </div>
    <h3>@ViewBag.Title</h3>
  </div>
</div>

<div class="row">
  <div class="col-md-2 sidebar">
    @Html.Partial("StackedNavBar", menuBar)
    @Html.Partial("CredentialSideBar", sideBar)
  </div>
  <div class="col-md-10 m-t-sm">
    @RenderBody()
  </div>
</div>

@section scripts
{
  @RenderSection("pagescripts", false)
}

