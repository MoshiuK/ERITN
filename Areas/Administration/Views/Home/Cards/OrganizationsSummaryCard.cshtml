@model AccessManagement.Web.Areas.Administration.ViewModels.Home.OrganizationsSummaryCardViewModel
@using AccessManagement.Web.Areas.Storefront
@using Juillet.Web.Mvc.Html
<div class="card">
  <div class="card-heading">
    <div class="card-title">
      <h3 class="heading-inline-block">Organizations</h3>
      <div class="pull-right">
        <small><a href="@Url.Action("Index", "OrganizationsHub")">All Organizations @Html.GlyphFa("arrow-circle-right")</a></small>
      </div>
    </div>
  </div>
  <div class="card-content text-info">
    @Html.DisplayFor(m => m.ActiveOrganizationsCount)
    <div>
      <ul class="list-unstyled">
        <li>@Html.GlyphFa("arrow-right") @Html.ActionLink("Find an organization", "Index", "OrganizationsHub", null, new { @class = "btn btn-link" })</li>
        <li>@Html.GlyphFa("arrow-right") @Html.ActionLink("Register a new organization", "Register", "Registration", StorefrontAreaRegistration.AreaRouteValues, new { @class = "btn btn-link" })</li>
      </ul>
    </div>
  </div>
</div>
