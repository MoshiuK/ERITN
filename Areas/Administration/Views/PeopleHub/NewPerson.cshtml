@model AccessManagement.Web.Areas.Administration.ViewModels.PeopleHub.NewPerson
@using Juillet.Web.Mvc
@using Juillet.Web.Mvc.Html
@{
  Layout = "../Shared/_AdministrationLayout.cshtml";
  var menuBar = (NavBar)ViewBag.MenuBar ?? new NavBar();
  var returnUrl = (string) ViewBag.ReturnUrl ?? this.Url.Action("Directory", "PeopleHub");
}

<div class="row">
  <div class="col-md-12 text-center">
    <h1>New Person</h1>
  </div>
</div>

@using (Html.BeginForm("NewPerson", "PeopleHub", null, FormMethod.Post, new {@class = "form-horizontal"}))
{
  @Html.AntiForgeryToken()

  <div class="row">
    <div class="col-lg-offset-2 col-md-8">
      <div class="form-group">
        @Html.LabelFor(m => m.Name)
        @Html.EditorFor(m => m.Name)
        @Html.ValidationMessageFor(m => m.Name)
      </div>
      <div class="form-group">
        @Html.LabelFor(m => m.Email)
        @Html.EditorFor(m => m.Email)
        @Html.ValidationMessageFor(m => m.Email)
      </div>
      <div class="form-group">
        @Html.LabelFor(m => m.Phone)
        @Html.EditorFor(m => m.Phone)
        @Html.ValidationMessageFor(m => m.Phone)
      </div>
      
      <hr/>
      <div class="form-group">
        <div class="form-inline">
          @Html.RadioButtonFor(m => m.AccountType, "Managed", new {@class = "radio", @checked = "checked"})
          <label>Create a managed account.</label>
        </div>
        <div class="m-l-md">
          <span>
            Use a managed account when an organization manages takes responsibility for the person's details.  The person
            will <strong>not</strong> have a user name and password to sign in.
          </span>
          <div class="row m-t-sm">
            <div class="col-sm-3">
              @Html.LabelFor(m => m.ManagedByOrganization)
            </div>
            <div class="col-sm-9">
              @Html.EditorFor(m => m.ManagedByOrganization)
              @Html.ValidationMessageFor(m => m.ManagedByOrganization)
            </div>
          </div>
          <div class="row m-t-sm">
            <div class="col-sm-3">
              @Html.LabelFor(m => m.OrganizationRelationship)
            </div>
            <div class="col-sm-9">
              @Html.EditorFor(m => m.OrganizationRelationship)
              @Html.ValidationMessageFor(m => m.OrganizationRelationship)
            </div>
          </div>
        </div>
      </div>
      <div class="form-group m-t-lg">
        <div class="form-inline">
          @Html.RadioButtonFor(m => m.AccountType, "SelfService", new {@class = "radio"})
          <label>Create a self-service account.</label>
        </div>
        <div class="m-l-md">
          <span>
            Use a self-service account when the person creates their own user name and password and signs in to 
            manage their own details.
          </span>
          <div class="alert alert-info m-t-sm">
            <strong>@Html.GlyphFa("envelope-o")</strong>
            An invitation to sign up will be emailed to the person when you click <strong>Create</strong>.
          </div>
        </div>
      </div>

      <div class="m-t-lg pull-right">
        <button type="submit" class="btn btn-primary btn-lg">Create</button>
        <a class="btn btn-default m-l-lg" href="@returnUrl">Cancel</a>
      </div>
    </div>
  </div>
}