@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.Areas.Administration.ViewModels.PeopleHub.CredentialNavigationPageViewModel
@{
  Layout = "../Shared/_HubLayout.cshtml";
}

<div class="row m-t-md">
  <div class="col-md-6">
    <div class="card">
      <div class="card-title">
        <h3>Search for credentials</h3>
      </div>
      <div class="card-content card-300px-scrollable">
        <div>
          @using (Html.BeginForm("CredentialsTableSearch", "PeopleHub", FormMethod.Get))
          {
            <div class="input-group">
              <input type="text" name="Expression" class="form-control" placeholder="Name"/>
              <span class="input-group-btn">
                <button type="submit" class="btn btn-default">@Html.GlyphFa("search")</button>
              </span>
            </div>
          }
        </div>
        @Html.ActionLink("Browse all credentials", "CredentialsTableSearch", null, new { @class = "btn btn-link" })
        <h6 class="text-muted">Recently seen credentials</h6>
        <ul class="list-unstyled">
          @foreach (var next in Model.RecentItems)
          {
            <li>@Html.ActionLink(next.Annotation, "Credential", new { id = next.Id })</li>
          }
        </ul>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card">
      <div class="card-title">
        <h3>Emergency Events</h3>        
      </div>
      <div class="card-content card-300px-scrollable">
        @Html.DisplayFor(m => m.Events)
      </div>
    </div>
  </div>
</div>

<div class="row">
  
  <div class="col-md-6">
    <div class="card">
      <div class="card-title">
        <h3>Organizations</h3>
      </div>
      <div class="card-content card-300px-scrollable">
        @Html.DisplayFor(m => m.Organizations)
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card">
      <div class="card-title">
        <h3>Jurisdictions</h3>
      </div>
      <div class="card-content card-300px-scrollable">
        @Html.DisplayFor(m => m.Jurisdictions)
      </div>
    </div>
  </div>

</div>
