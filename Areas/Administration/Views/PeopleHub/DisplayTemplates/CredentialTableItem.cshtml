@model AccessManagement.Web.Areas.Administration.ViewModels.PeopleHub.CredentialTableItem

<div class="credentials-table-item">
  <div class="row">
    <div class="col-md-12">
      <h4>@Html.DisplayFor(m => m.Member.Name)</h4>
    </div>
  </div>

  @foreach (var credential in Model.Credentials)
  {
    <a class="undecorated-link" href="@Url.Action("Credential", "PeopleHub", new { id = credential.CorrelationId})">
      <div class="credential">
        <div class="credential-access-level">
          @Html.DisplayFor(_ => credential.AccessLevel)
        </div>
        <div class="credential-info-line">
          <strong>@Html.DisplayFor(_ => credential.EmergencyEvent.Name)</strong><br />
          <small class="text-muted">
            @Html.DisplayFor(_ => credential.CreatedOn); @Html.DisplayFor(_ => credential.CredentialType.Name)
          </small>
        </div>
        <div class="credential-info-line pull-right">
          @if (credential.IssuingOrganizationAvatar != null)
          {
            @Html.DisplayFor(_ => credential.IssuingOrganizationAvatar)
          }
          @if (credential.IssuingJurisdictionAvatar != null)
          {
            @Html.DisplayFor(_ => credential.IssuingJurisdictionAvatar)
          }
        </div>
        <div class="credential-info-line pull-right">
          @Html.DisplayFor(_ => credential.IssuingOrganization.Name)
          @Html.DisplayFor(_ => credential.IssuingJurisdiction.Name)          
        </div>
      </div>
    </a>
  }
</div>