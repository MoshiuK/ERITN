@model AccessManagement.Web.Areas.Administration.ViewModels.PeopleHub.CredentialsTablePageViewModel

@{
  Layout = "../Shared/_HubLayout.cshtml";
}

<div class="credentials-table">
  <div class="row">
    <div class="col-md-12">
      <div class="panel">
        <div class="panel-body">
          <h2>Browse Credentials</h2>
          @using (Html.BeginForm("CredentialsTableSearch", "PeopleHub", FormMethod.Get))
          {
            <div class="row">
              <div class="col-md-10">
                @Html.EditorFor(m => m.Criteria)
              </div>
              <div class="col-md-2">
                <button class="btn btn-primary btn-lg m-t-lg">Apply Filter</button>
              </div>
            </div>
          }
        </div>
      </div>
    </div>
  </div>

  @if (Model.HasResults)
  {
    <div class="row">
      <div class="col-md-12">
        <div class="panel">
          <div class="panel-body">
            @foreach (var next in Model.PageOfContent.Data)
            {
              @Html.DisplayFor(_ => next)
            }
          </div>
        </div>
      </div>
    </div>
  }
  else
  {
    <div class="row">
      <div class="col-md-12">
        <div class="panel">
          <div class="panel-body">
            <h4><i class="fa fa-search fa-lg"></i> No credentials were found.</h4>
            <small>
              There were no matches. @Model.ToDisplayString()
            </small>
          </div>
        </div>
      </div>
    </div>

  }
</div>