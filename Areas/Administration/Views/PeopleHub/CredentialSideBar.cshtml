@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.Areas.Administration.ViewModels.PeopleHub.CredentialSideBarViewModel

<div class="row">
  <div class="m-b-md m-t-lg">
    @Html.LabelFor(m => m.Active, new { @class = "sidebar-caption" })
    @if (Model.TerminatedOn == null)
    {
      <div class="label label-sidebar-status active">ACTIVE</div>
      <button class="btn btn-warning btn-block m-t-sm">@Html.GlyphFa("pause") Deactivate</button>
    }
    else
    {
      <div class="label label-sidebar-status inactive">INACTIVE</div>
      <button class="btn btn-success btn-block m-t-sm">@Html.GlyphFa("play") Activate</button>
    }
  </div>
</div>

<div class="row">
  <div class="col-sm-12">
    @Html.LabelFor(m => m.CreatedOn, new { @class = "sidebar-caption" })
    <span class="sidebar-value">@Html.DisplayFor(m => m.CreatedOn)</span>
  </div>
</div>
@if (Model.IssuedOn.HasValue)
{
  <div class="row">
    <div class="col-sm-12">
      @Html.LabelFor(m => m.IssuedOn, new {@class = "sidebar-caption"})
      <span class="sidebar-value">@Html.DisplayFor(m => m.IssuedOn)</span>
    </div>
  </div>
}
@if (Model.TerminatedOn.HasValue)
{
  <div class="row">
    <div class="col-sm-12">
      @Html.LabelFor(m => m.TerminatedOn, new {@class = "sidebar-caption"})
      <span class="sidebar-value">@Html.DisplayFor(m => m.TerminatedOn)</span>
    </div>
  </div>
}