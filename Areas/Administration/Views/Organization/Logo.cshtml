@model AccessManagement.Web.Areas.Administration.ViewModels.Organizations.OrganizationLogoSettings
@using Juillet.Web.Mvc.Html
@{
  Layout = "_OrganizationTabLayout.cshtml";
}

<div class="row">
  <div class="col-md-12">
    <div class="panel">
      <div class="panel-heading">
        <h4 class="heading-inline-block">@Html.GlyphFa("picture-o") Organization Logo</h4>
      </div>
      <div class="panel-body">
        <div class="row">
          <div class="col-md-4 profile-image-container">
            @Html.LabelFor(m => m.Avatar)
            @Html.DisplayFor(m => m.Avatar)
          </div>
          <div class="col-md-8">
            @using (Html.BeginForm("Logo", "Organization", null, FormMethod.Post, new {enctype = "multipart/form-data"}))
            {
              @Html.AntiForgeryToken()

              @Html.LabelFor(m => m.AvatarEditAndUpload)
              @Html.EditorFor(m => m.AvatarEditAndUpload)

              <div class="pull-right m-t-lg">
                <button type="submit" class="btn btn-primary btn-lg">Update</button>
              </div>
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

@section pagescripts
{
  <script src="~/Scripts/pages/administration.organization.logo.js"></script>
}
