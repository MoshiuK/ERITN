@model AccessManagement.Models.Emergency.EmergencyEvent
@using System.Web.Mvc.Html
@using AccessManagement.Web.Areas.Operations.ViewModels.Events

@{
    var sideBar = (EventsSidebar)ViewBag.SideBar ?? new EventsSidebar();
}

<div class="row m-b-sm">
    <div class="col-md-2">
        @Html.Partial("EventsSidebar", sideBar)
    </div>
    <div class="col-md-10">
        <div class="row">
          <div>
            @if (Model == null)
            {
              <p class="text-muted">
                <em>No events found.</em>
              </p>
            }
            else
            {
              <h4>Emergency Event</h4>
              <hr/>
              @Html.DisplayFor(_ => Model)

              <input type="button" class="btn btn-danger" value="Delete Event" onclick="location.href = '@Url.Action("Delete", "Events", new {id = Model.CorrelationId})'"/>
            }
          </div>
        </div>
    </div>
</div>