@model AccessManagement.Web.Areas.Operations.ViewModels.Tenants.TenantDiscoveryEditableData
<div class="row">
  <div class="col-md-12">
    <h3>Tile Image</h3>

    <p class="help-text">
      The tile image is displayed on tiles, menu headers and flyouts.  Recommended dimensions: 600 x 400 pixels.  This must be a publicly addressable
      resource.
    </p>

    @if (string.IsNullOrEmpty(Model.TileImageUri))
    {
      <div class="well">
        <p class="text-center text-danger">
          <small>No tile image is set.</small>
        </p>
      </div>
    }
    else
    {
      <div class="text-center">
        <img class="m-sm" alt="Banner Image URI" src="@Html.ValueFor(m => m.TileImageUri)" />
      </div>
    }
      
    @Html.LabelFor(m => m.TileImageUri)
    @Html.EditorFor(m => m.TileImageUri)

  </div>
</div>

