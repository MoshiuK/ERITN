@model AccessManagement.Web.Areas.Operations.ViewModels.Tenants.TenantSummaryPageViewModel
<div class="row">
  <div class="col-md-2">
    @Html.Action("TenantNavigationLinks", new { selection = Model.Tenant.CorrelationId })
  </div>
  <div class="col-md-10">
    <div class="row">
      <div class="col-md-6">
        @Html.Partial("Cards/TenantIntro", Model.Tenant, this.ViewData)
      </div>
      <div class="col-md-6">
        @Html.Partial("Cards/Administrators", Model.AdministratorsCard)
      </div>
    </div>
  </div>
</div>
