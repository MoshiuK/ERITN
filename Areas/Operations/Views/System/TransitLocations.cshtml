@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.Areas.Operations.ViewModels.System.TransitLocationsPageViewModel

<div class="row m-b-md">
  <div class="col-md-12">
    @Html.ActionLink("Add New Transit Location", "NewTransitLocation", null, new { @class = "btn btn-primary" })
  </div>
</div>

@foreach (var item in Model.TransitLocations)
{
  <div class="row">
    <div class="col-md-9">
      <div class="panel panel-default">
        <div class="panel-heading">
          <h3>
            @Html.DisplayFor(_ => item.Name)
          </h3>
        </div>
        <div class="panel-body">
          <p>
            @Html.DisplayFor(_ => item.Description)
            The ID for this transit location is <code> @Html.DisplayFor(_ => item.CorrelationId)</code>
          </p>
          @foreach (var tenant in item.Tenants)
          {
            <div class="row m-t-sm">
              <div class="col-md-4">
                <strong>@Html.DisplayFor(_ => tenant.Annotation)</strong>
              </div>
              <div class="col-md-1">
                @{
                  var caption = tenant.Selected ? "Disable" : "Enable";
                  var style = tenant.Selected ? "red" : "green";
                }
                <button sps-action="toggle-selection" class="ladda-button"
                        data-tenant="@tenant.Id" data-transitlocation="@item.CorrelationId" data-selected="@tenant.Selected"
                        data-style="expand-right" data-size="xs" data-color="@style">
                  @caption <span class="ladda-label"></span>
                </button>
              </div>
            </div>
          }
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card">
        <div class="card-title">
          <h5 class="p-w-md">Logo for @Html.ValueFor(_ => item.Name)</h5>
        </div>
        <div class="card-content text-center">
          @if (item.HasAvatar)
          {
            @Html.DisplayFor(_ => item.Avatar)
          }
          else
          {
            <div class="alert alert-danger"><strong>@Html.GlyphFa("exclamation-circle")</strong>&nbsp; Logo Required.</div>
          }
        </div>
        <div class="card-footer card-footer-nav-l">
          <ul class="nav nav-pills">
            <li><a href="#" data-upload-logo-dialog="@Url.Action("UploadTransitLocationLogoDialog", new { correlationId = item.CorrelationId })">@Html.GlyphFa("upload", GlyphStyles.Large)</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
}

@section pagescripts
{
  <script src="~/Scripts/pages/operations.system.transitlocations.js"></script>
  <div id="uploadLogoDialog" class="modal" role="dialog">
    <span>Loading...</span>
  </div>
}