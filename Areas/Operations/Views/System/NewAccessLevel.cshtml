@model AccessManagement.Web.Areas.Operations.ViewModels.System.NewAccessLevel

<div class="row">
  <div class="col-md-offset-3 col-md-6">
    <div class="panel">
      <div class="panel-body">
        @using (Html.BeginForm("NewAccessLevel"))
        {
          @Html.AntiForgeryToken()

          @Html.EditorForModel()

          @Html.ActionLink("Cancel", "AccessLevels", null, new {@class = "btn btn-default"})
          <button type="submit" class="btn btn-primary">Create</button>
        }
      </div>
    </div>
  </div>
</div>
