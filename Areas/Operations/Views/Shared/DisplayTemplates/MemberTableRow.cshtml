@model AccessManagement.Web.Areas.Operations.ViewModels.Members.MemberPageSummaryLine

<tr>
  <td>
    <small>
      @Html.DisplayFor(m => m.Active)
    </small>
  </td>
  <td>
    <small>
      @Html.DisplayFor(m => m.Deleted)
