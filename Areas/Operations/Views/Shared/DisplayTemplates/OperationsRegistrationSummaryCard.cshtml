@model AccessManagement.Web.Areas.Operations.ViewModels.RegistrationSummary

<div class="row">
  <div class="col-md-6 text-center">
    <h3>
      <small>
        @Html.LabelFor(m => m.Registrations)
      </small> <br />
      <span id="Registrations">
        @Html.DisplayFor(m => m.Registrations)
      </span>
    </h3>
  </div>
  <div class="col-md-6 text-center">
    <h3>
      <small>
        @Html.LabelFor(m => m.AbandonedRegistrations)
      </small> <br />
      <span id="AbandonedRegistrations">
        @Html.DisplayFor(m => m.AbandonedRegistrations)
      </span>
    </h3>
  </div>
</div>
<div class="row">
  <div class="col-md-6 text-center">
    <h3>
      <small>
        @Html.LabelFor(m => m.FailedRegistrations)
      </small> <br />
      <span id="FailedRegistrations">
        @Html.DisplayFor(m => m.FailedRegistrations)
      </span>
    </h3>
  </div>
  <div class="col-md-6 text-center">
  </div>
</div>
