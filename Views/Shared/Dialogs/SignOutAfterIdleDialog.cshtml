@using AccessManagement.Web.Mvc
@if (!Html.IsDebug() && User.Identity.IsAuthenticated)
{
  var waitInterval = 10;
  var idleTimeout = (int)TimeSpan.FromMinutes(15).TotalMilliseconds;
  
  <div id="signOutAfterIdleDialog" 
       class="modal fade" 
       tabindex="-1" 
       role="dialog" 
       data-timeout-millis="@idleTimeout"
       data-wait-interval="@waitInterval">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          <h4 class="modal-title">Your session will expire</h4>
        </div>
        <div class="modal-body">
          <p>
            Signing you out of the application in <span id="signOutSecondsField">@waitInterval</span> seconds.
          </p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">Reload Page</button>
        </div>
      </div>
    </div>
  </div>
}
else
{
  <!-- sign out on idle dialog not required -->
}