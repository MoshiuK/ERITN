@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.ViewModels.Body.UploadCorrelatedLogoDialog
<div class="modal-dialog" role="document">
  @using (Html.BeginForm(
    Model.PostToAction.Action,
    Model.PostToAction.Controller,
    null,
    FormMethod.Post,
    new { area = Model.PostToAction.Area, enctype = "multipart/form-data" }))
  {
    @Html.AntiForgeryToken()

    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title">@Html.DisplayFor(m => m.Title)</h4>
      </div>
      <div class="modal-body" style="min-height: 200px">
        <p>@Html.DisplayFor(m => m.Preamble)</p>
        <div class="row">
          <div class="col-md-12">
            @Html.Hidden("id", Model.CorrelationId)
            @Html.EditorFor(m => m.Logo)
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
        <input class="btn btn-lg btn-primary" type="submit" value="Upload" />
      </div>
    </div>
  }
</div>

