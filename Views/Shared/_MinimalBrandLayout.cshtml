@using System.Security.Claims
@using AccessManagement.Framework.Tenants
@using AccessManagement.Web.Mvc
@using Juillet.SystemExtensions
<!DOCTYPE html>
<html>
@{
    var theme = (TenantTheme)ViewBag.Theme;
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="shortcut icon" href="@theme.ImageUrlFavicon" />
    <title>@ViewBag.Title - @theme.PageTitleSuffix</title>
    @Styles.Render("~/Content/css/tenant-base")
    @Styles.Render(theme.StorefrontStyleBundle)

    @Scripts.Render("~/Scripts/modernizr")
    @Html.Partial("_AiScriptPartial")
</head>
<body>
    <div class="container">
        <nav class="navbar navbar-inverse navbar-static-top" role="toolbar">
            <div class="container-fluid">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                    <a href="@Url.GetBrandUrlFor(User)"><img class="navbar-brand" src="@theme.SquareLogoInverse" alt="Logo for @theme.BrandCaption" /></a>
                    <a href="@Url.GetBrandUrlFor(User)" class="navbar-brand">@theme.BrandCaption</a>
                </div>
                <div class="navbar-collapse collapse">
                    @if (Request.IsAuthenticated)
                    {
                        <ul class="nav navbar-nav navbar-right">
                            <li class="dropdown toolbar-profile-dropdown">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                                    <div class="toolbar-profile">
                                        <img class="profile-avatar" src="data:image/png;base64," alt="@User.Identity.Name" />
                                    </div>
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <div class="toolbar-profile-dropdown-item">
                                            <span class="profile-title">@User.Identity.Name</span>
                                            <span class="profile-subtitle">@User.Identity.FindClaimValue(ClaimTypes.Upn)</span>
                                        </div>
                                    </li>
                                    <li role="separator" class="divider"></li>
                                    <li>@Html.ActionLink("Profile", "Index", "Profile", new { area = "" }, null)</li>
                                    <li>@Html.ActionLink("Change Password", "ChangePassword", "Profile", new { area = "" }, null)</li>
                                    <li role="separator" class="divider"></li>
                                    <li>@Html.ActionLink("Sign Out", "SigningOut", "Authentication", new { area = "" }, null)</li>
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
        <div class="container-fluid body-content">
            @RenderBody()
        </div>

        <div id="footer" class="footer footer-default">
            <div class="pull-right">
                <span>
                    <small>@theme.BrandCaption</small>
                </span>
                <span class="m-r-sm m-l-sm">
                    |
                </span>
                <span class="m-r-md">
                    <small>Copyright &copy; 2018 - TruEntry LLC.</small>
                </span>
                <div class="social-buttons-container">
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/Scripts/jquery")
    @Scripts.Render("~/Scripts/portal")
    @Scripts.Render(theme.ScriptBundle)
    @RenderSection("scripts", required: false)
</body>
</html>
