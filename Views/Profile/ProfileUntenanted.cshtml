@{
  Layout = "~/Views/Shared/_NoBrandLayout.cshtml";
}
<div class="page-jumbotitle">
  <h1>@ViewBag.Title</h1>
  <h4 class="page-jumbotitle-info">
    Control your profile settings and decide how to make our services work better for you.
  </h4>
</div>

<div class="row m-t-lg">
  <div class="col-md-4">
    <img src="https://via.placeholder.com/200x800" alt="Profile Details" />
  </div>
  <div class="col-md-8">
    <img src="https://via.placeholder.com/400x800" alt="Recent activities, favorites, etc." />
  </div>
</div>

@Html.ActionLink("Update profile", "Edit", null, new { @class = "btn btn-lg btn-primary" })
