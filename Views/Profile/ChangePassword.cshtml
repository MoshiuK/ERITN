@using Juillet.Web.Mvc.Html
@model AccessManagement.Web.ViewModels.Profile.ChangePassword
@{
  Layout = "~/Views/Shared/_MinimalBrandLayout.cshtml";
}
<div class="page-jumbotitle">
  <h1>@ViewBag.Title</h1>
  <h4 class="page-jumbotitle-info">
    Control access with a strong password to protect your account.
  </h4>
</div>

<div class="m-t-lg">
  @using (Html.BeginForm("ChangePassword", "Profile", FormMethod.Post))
  {
    @Html.AntiForgeryToken()

    <div class="row">
      <div class="col-md-offset-4 col-md-4">
        @Html.EditorForModel()
      </div>
    </div>

    <div class="row m-t-md">
      <div class="col-md-12 text-center">
        <a class="btn btn-link btn-lg" href="@Url.Action("Index")">
          @Html.GlyphFa("arrow-left") &nbsp;Back to Profile
        </a>
        <button type="submit" class="btn btn-primary btn-lg">Change Password</button>
      </div>
    </div>
  }
</div>
