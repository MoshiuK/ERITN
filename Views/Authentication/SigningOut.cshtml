@using AccessManagement.Framework.Tenants
@{
  Layout = "~/Views/Shared/_MinimalBrandLayout.cshtml";
  var theme = (TenantTheme)ViewBag.Theme;
  var signOutUrl = ViewBag.SignOutUrl;
}
<div class="page-jumbotitle">
  <h1>@ViewBag.Title</h1>
  <h4 class="page-jumbotitle-info">
    Signing you out of @theme.BrandCaption
  </h4>
</div>

<div class="row m-t-lg">
  <div class="col-md-12 text-center">
    <h2>Please wait while we sign you out...</h2>
    <p>
      This will only take a few seconds.
    </p>
  </div>
</div>

@section scripts
{  
  <script type="text/javascript">
    $(document)
      .ready(function () {
        console.log("Signing out with '@signOutUrl'");
        setTimeout(function () {
          window.location.assign('@signOutUrl');
        }, 500);
      });
  </script>
}
